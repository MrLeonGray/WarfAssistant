<UserControl x:Class="WarfAssistant.Views.CraftingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1120">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER: Title, Presets & Blueprint Search -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Title + Quick Presets -->
                <Grid Grid.Row="0" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔨 КРАФТ И ФАРМ"
                                   FontSize="14" FontWeight="ExtraBold" Foreground="{StaticResource BrushGold}" VerticalAlignment="Center"/>
                        <Border Background="#182232" BorderBrush="#263449" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DE Рецепты • Склад • Оптимальные ноды" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Быстро:" FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="+ 💠 Форма" Command="{Binding AddPresetBlueprintCommand}" CommandParameter="Форма"
                                Style="{StaticResource PillButton}" Margin="0,0,4,0"/>
                        <Button Content="+ ⚡ Катализатор" Command="{Binding AddPresetBlueprintCommand}" CommandParameter="Катализатор Орокин"
                                Style="{StaticResource PillButton}" Margin="0,0,4,0"/>
                        <Button Content="+ ⚡ Реактор" Command="{Binding AddPresetBlueprintCommand}" CommandParameter="Реактор Орокин"
                                Style="{StaticResource PillButton}" Margin="0,0,4,0"/>
                        <Button Content="+ ⭐ Эксилус" Command="{Binding AddPresetBlueprintCommand}" CommandParameter="Эксилус Адаптер"
                                Style="{StaticResource PillButton}" Margin="0,0,4,0"/>
                        <Button Content="+ 💠 Умбра" Command="{Binding AddPresetBlueprintCommand}" CommandParameter="Форма: Умбра"
                                Style="{StaticResource PillButton}" Margin="0,0,4,0"/>
                        <Button Content="+ 🔋 Энергия x100" Command="{Binding AddPresetBlueprintCommand}" CommandParameter="Восстановитель Энергии (x100)"
                                Style="{StaticResource PillButton}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Search Box, Options & Queue Totals -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Blueprint Search + Dropdown -->
                    <Grid Grid.Column="0">
                        <Border x:Name="SearchBoxBorder" Background="{StaticResource BrushBgInput}"
                                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                                CornerRadius="6" Padding="9,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CraftBlueprintSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource BrushTextPrimary}"
                                         FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Поиск (Миса, Форма: Омни, Линза)..."
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding IsSearchTextEmpty, Converter={StaticResource BoolToVis}}"/>
                                <Button Grid.Column="2" Content="✕" Command="{Binding ClearBlueprintSearchCommand}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource BrushTextMuted}" Cursor="Hand"
                                        Padding="4,0" FontSize="11" ToolTip="Очистить поиск"/>
                            </Grid>
                        </Border>

                        <Popup IsOpen="{Binding IsBlueprintSearchDropdownOpen}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=SearchBoxBorder}"
                               Placement="Bottom" Width="360" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border Background="#121824" BorderBrush="{StaticResource BrushCyan}"
                                    BorderThickness="1" CornerRadius="0,0,8,8" Padding="6" Margin="0,2,0,0">
                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AvailableBlueprintsForAdd}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectBlueprintForAddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#162030" BorderBrush="#253245" BorderThickness="1"
                                                        Margin="0,0,0,4" Padding="8,5" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Grid Width="22" Height="22" Margin="0,0,7,0">
                                                                            <TextBlock Text="{Binding IconGlyph}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       Visibility="{Binding HasLoadedThumbnail, Converter={StaticResource InverseBoolToVis}}"/>
                                                                            <Image Source="{Binding ThumbnailBitmap}" Width="22" Height="22" Stretch="Uniform"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                                                                   Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                        <Border Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1">
                                                                            <TextBlock Text="{Binding SubCategory}" FontSize="9" FontWeight="Bold" Foreground="#0A0E14"/>
                                                                        </Border>
                                                                        <TextBlock Text="+ В крафт" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="7,0,0,0"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Solver Toggles (Stock-aware expansion is always active automatically!) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="💀 Стальной Путь (+100% дроп)"
                                  IsChecked="{Binding PrioritizeSteelPath}"
                                  FontSize="10.5" Foreground="{StaticResource BrushGold}"
                                  VerticalAlignment="Center"
                                  ToolTip="Учитывать бонус Стального Пути при выборе оптимальных миссий фарма"/>
                    </StackPanel>

                    <!-- Queue Summary & Clear -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Очередь: " FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding TotalQueueItemsCount}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                                <TextBlock Text=" поз. (" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding TotalQueueUnitsCount}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text=" шт.) • " FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding TotalCreditsDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushGold}"/>
                            </StackPanel>
                        </Border>

                        <Button Content="🗑 Очистить" Command="{Binding ClearCraftQueueCommand}"
                                Style="{StaticResource PillButton}" Foreground="{StaticResource BrushHealthRed}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- MAIN 2-COLUMN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="465"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Top = Queue, Bottom = Aggregated Warehouse & Deficit Editor -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.05*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="1.15*"/>
                </Grid.RowDefinitions>

                <!-- TOP-LEFT: CRAFT QUEUE -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushBgCard}"
                            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1,1,1,0"
                            CornerRadius="8,8,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📦 ОЧЕРЕДЬ КУЗНИЦЫ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                                <Border Background="#1C2636" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding TotalQueueItemsCount, StringFormat='{}{0} выбрано'}" FontSize="10" Foreground="{StaticResource BrushCyan}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Количество ×1..99" FontSize="9" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource BrushBgSurface}"
                            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1,0,1,1"
                            CornerRadius="0,0,8,8" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Empty State -->
                                <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}"
                                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6"
                                        Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🛠" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Очередь крафта пуста" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushGold}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Найдите чертёж в поиске сверху, нажмите кнопку быстрого пресета или [+ В крафт] в Коллекции."
                                                   FontSize="10" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Queue Cards -->
                                <ItemsControl ItemsSource="{Binding CraftQueue}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,7">
                                                <StackPanel>
                                                    <!-- Header Row -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Grid Width="22" Height="22" Margin="0,0,7,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding IconGlyph}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="{Binding HasLoadedThumbnail, Converter={StaticResource InverseBoolToVis}}"/>
                                                                <Image Source="{Binding ThumbnailBitmap}" Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                                                       Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                            <Border Background="#1F2A38" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Category}" FontSize="8" Foreground="{StaticResource BrushCyan}"/>
                                                            </Border>
                                                            <Border Background="#2D2016" BorderBrush="#92400E" BorderThickness="1" CornerRadius="3"
                                                                    Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsVaulted, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="ХРАН." FontSize="7.5" FontWeight="Bold" Foreground="#FBBF24"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Qty Stepper -->
                                                            <Border Background="{StaticResource BrushBgSurface}" BorderBrush="#263347"
                                                                    BorderThickness="1" CornerRadius="4" Padding="2,1" Margin="0,0,5,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Content="−" Width="16" Height="16" FontSize="10" FontWeight="Bold"
                                                                            Command="{Binding DataContext.DecrementQueueQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextMuted}" Cursor="Hand"/>
                                                                    <TextBlock Text="{Binding Quantity, StringFormat='×{0}'}" FontSize="10" FontWeight="Bold"
                                                                               Foreground="{StaticResource BrushGold}" VerticalAlignment="Center" Margin="3,0"/>
                                                                    <Button Content="+" Width="16" Height="16" FontSize="10" FontWeight="Bold"
                                                                            Command="{Binding DataContext.IncrementQueueQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushCyan}" Cursor="Hand"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Time + Crafted + Remove -->
                                                            <Border Background="#1C2433" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                                                                <TextBlock Text="{Binding CraftTimeDisplay}" FontSize="9" Foreground="{StaticResource BrushGold}"/>
                                                            </Border>
                                                            <Button Content="✓"
                                                                    Command="{Binding DataContext.MarkCraftedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#132D20" BorderBrush="#10B981" BorderThickness="1"
                                                                    Foreground="#34D399" Cursor="Hand" Padding="5,1" FontSize="10" FontWeight="Bold"
                                                                    Margin="0,0,4,0" ToolTip="Отметить как скрафченное (спишет ресурсы со склада и отметит в коллекции)"/>
                                                            <Button Content="✕"
                                                                    Command="{Binding DataContext.RemoveCraftQueueItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextMuted}"
                                                                    Cursor="Hand" Padding="3,0" FontSize="11" ToolTip="Удалить из очереди"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Sub-component clickable pills (toggle pre-crafted stock) + Credits + Relic/Market hints -->
                                                    <Grid Margin="0,4,0,3" Visibility="{Binding HasNonRootSteps, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ItemsControl Grid.Column="0" ItemsSource="{Binding NonRootSteps}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Command="{Binding DataContext.TogglePreOwnedStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="{Binding PillToolTip}" Cursor="Hand" Margin="0,0,4,3">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="StepPill" CornerRadius="3" Padding="5,1.5" BorderThickness="1">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Background" Value="#121C29"/>
                                                                                            <Setter Property="BorderBrush" Value="#25364C"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsPreOwnedComplete}" Value="True">
                                                                                                    <Setter Property="Background" Value="#122C22"/>
                                                                                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <TextBlock Text="{Binding DisplayText}" FontSize="8.5" FontWeight="SemiBold">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Foreground" Value="{StaticResource BrushCyan}"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsPreOwnedComplete}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="#34D399"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Grid.Column="1" Text="{Binding CreditsDisplay}"
                                                                   Visibility="{Binding HasCreditsCost, Converter={StaticResource BoolToVis}}"
                                                                   FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrushGold}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- Single-row credits when no sub-steps -->
                                                    <TextBlock Text="{Binding CreditsDisplay}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrushGold}" Margin="0,3,0,2">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding HasCreditsCost}" Value="True"/>
                                                                            <Condition Binding="{Binding HasNonRootSteps}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Text="{Binding RelicHintText}" Visibility="{Binding HasRelicHint, Converter={StaticResource BoolToVis}}"
                                                               FontSize="8.5" Foreground="#E2B76E" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding MarketPriceHint}" Visibility="{Binding HasMarketPriceHint, Converter={StaticResource BoolToVis}}"
                                                               FontSize="8.5" Foreground="#38BDF8" Margin="0,0,0,3"/>

                                                    <!-- Compact Per-Item Ingredients w/ DE Game Icons -->
                                                    <ItemsControl ItemsSource="{Binding Resources}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource BrushBgSurface}" CornerRadius="3" Padding="6,2.5" Margin="0,1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Grid Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                <Border Background="#182232" CornerRadius="3"
                                                                                        Visibility="{Binding HasLoadedIcon, Converter={StaticResource InverseBoolToVis}}">
                                                                                    <TextBlock Text="◆" FontSize="9" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <Image Source="{Binding IconBitmap}" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                            </Grid>
                                                                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding CurrentAmount, StringFormat='{}{0:N0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushGold}"/>
                                                                            <TextBlock Text=" / " FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                                                            <TextBlock Text="{Binding RequiredAmount, StringFormat='{}{0:N0}'}" FontSize="10" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,6,0"/>
                                                                            <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- BOTTOM-LEFT: INTERACTIVE WAREHOUSE & DEFICIT EDITOR (WITH REAL DE ICONS) -->
                <Border Grid.Row="2" Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                        CornerRadius="8" Padding="11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Σ СКЛАД И ДЕФИЦИТ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGold}"/>
                                <Border Background="#251A18" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding DeficitSummaryText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushHealthRed}"/>
                                </Border>
                            </StackPanel>

                            <CheckBox Grid.Column="1" Content="Только дефицит"
                                      IsChecked="{Binding OnlyShowDeficitResources}"
                                      FontSize="10" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DisplayAggregatedResources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBgSurface}" CornerRadius="5" Padding="8,5" Margin="0,2">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0" Width="22" Height="22" Margin="0,0,7,0" VerticalAlignment="Center">
                                                        <Border Background="#182232" BorderBrush="#26384E" BorderThickness="1" CornerRadius="3"
                                                                Visibility="{Binding HasLoadedIcon, Converter={StaticResource InverseBoolToVis}}">
                                                            <TextBlock Text="◆" FontSize="10" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image Source="{Binding IconBitmap}" Width="21" Height="21" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SourceHint}"
                                                                   Visibility="{Binding HasSourceHint, Converter={StaticResource BoolToVis}}"
                                                                   FontSize="8.5" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Interactive Warehouse Amount Editor -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Button Content="−" Width="17" Height="18" FontSize="10" FontWeight="Bold"
                                                                Command="{Binding DataContext.StepResourceDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="#1B2536" BorderBrush="#2C3C54" BorderThickness="1"
                                                                Foreground="{StaticResource BrushTextSecondary}" Cursor="Hand"/>
                                                        <TextBox Text="{Binding AmountInputText, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                                 PreviewKeyDown="ResourceStockTextBox_PreviewKeyDown"
                                                                 Width="56" Height="18" FontSize="10" FontWeight="Bold"
                                                                 Foreground="{StaticResource BrushGold}" Background="#0D131D"
                                                                 BorderBrush="#2C3C54" BorderThickness="1"
                                                                 TextAlignment="Right" VerticalContentAlignment="Center"
                                                                 Padding="3,0" Margin="2,0"/>
                                                        <Button Content="+" Width="17" Height="18" FontSize="10" FontWeight="Bold"
                                                                Command="{Binding DataContext.StepResourceUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="#1B2536" BorderBrush="#2C3C54" BorderThickness="1"
                                                                Foreground="{StaticResource BrushCyan}" Cursor="Hand"/>
                                                        <TextBlock Text="{Binding RequiredAmount, StringFormat=' / {0:N0}'}"
                                                                   FontSize="9" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="3" Background="{Binding StatusColor}" Opacity="0.92"
                                                            CornerRadius="3" Padding="6,2" VerticalAlignment="Center" MinWidth="82">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Bold"
                                                                   Foreground="#0A0E14" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                                             Height="3" Margin="0,4,0,0" BorderThickness="0"
                                                             Background="#0D1420" Foreground="{Binding StatusColor}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: OPTIMAL SET-COVER ROUTE + FARMING NODES (ONLY WHEN DEFICIT EXISTS) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Section Header w/ Planned Queue Target Context -->
                <Border Grid.Row="0" Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1,1,1,0"
                        CornerRadius="8,8,0,0" Padding="14,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎯 ОПТИМАЛЬНАЯ СТРАТЕГИЯ ФАРМА" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                            <Border Background="#1F3627" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding MatchedNodesSummaryText}" FontSize="10" Foreground="{StaticResource BrushSuccessGreen}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StrategyQueueContextText}" HorizontalAlignment="Right"
                                   FontSize="10" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- Optimal Route Summary Banner -->
                <Border Grid.Row="1" Background="#101E28" BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1,0,1,1" Padding="12,8"
                        Visibility="{Binding HasOptimalRoute, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding OptimalRouteSummaryText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushCyan}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding OptimalRouteSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#152836" BorderBrush="#10B981" BorderThickness="1"
                                            CornerRadius="5" Padding="8,5" Margin="0,0,8,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StepNumber, StringFormat='ШАГ {0}: '}" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                                <TextBlock Text="{Binding Node}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGold}"/>
                                                <TextBlock Text="{Binding Planet, StringFormat=' ({0})'}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CoversText}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding FissureNote}"
                                                       Visibility="{Binding HasFissureNote, Converter={StaticResource BoolToVis}}"
                                                       FontSize="8" FontWeight="Bold" Foreground="#C084FC" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Detailed Node Recommendation Cards OR Honest Empty Strategy Card -->
                <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1,0,1,1"
                        CornerRadius="0,0,8,8" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="#243347" BorderThickness="1"
                                    CornerRadius="7" Padding="16" Margin="0,4"
                                    Visibility="{Binding HasNoRecommendations, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                                    <TextBlock Text="📦 Нет дефицита ресурсов для фарма" FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource BrushGoldBright}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding EmptyStrategyHintText}" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding FarmRecommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{Binding CardBorderColor}"
                                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Node Header + Optimal Badge + Rating -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="{Binding BadgeBgColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding RouteBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding BadgeFgColor}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Node}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushGold}"/>
                                                    <TextBlock Text=" — " FontSize="13" Foreground="{StaticResource BrushTextMuted}"/>
                                                    <TextBlock Text="{Binding Planet}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    <Border Background="#1C2636" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding MissionType}" FontSize="10" Foreground="{StaticResource BrushCyan}"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="★" Foreground="{StaticResource BrushGold}" FontSize="12" Margin="0,0,3,0"/>
                                                    <TextBlock Text="{Binding CommunityRating, StringFormat='{}{0:F2}'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextPrimary}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 1: Live Void Fissure Synergy (if active) -->
                                            <Border Grid.Row="1" Background="#241536" BorderBrush="#9333EA" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,4" Margin="0,6,0,0"
                                                    Visibility="{Binding HasActiveFissure, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ActiveFissureBonus}" FontSize="10" FontWeight="Bold" Foreground="#E9D5FF" TextWrapping="Wrap"/>
                                            </Border>

                                            <!-- Row 2: Tags -->
                                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Tags}" Margin="0,7,0,5">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#251F10" BorderBrush="{StaticResource BrushGold}" BorderThickness="1"
                                                                CornerRadius="4" Padding="5,1" Margin="0,0,5,3">
                                                            <TextBlock Text="{Binding}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrushGold}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Row 3: Matched Resources -->
                                            <Border Grid.Row="3" Background="{StaticResource BrushBgSurface}" CornerRadius="5" Padding="8,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Закрывает дефицит:" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding MatchedResources}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#162E3B" BorderBrush="{StaticResource BrushCyan}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,2">
                                                                    <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>

                                            <!-- Row 4: Squad & Tip -->
                                            <StackPanel Grid.Row="4" Margin="0,0,0,6">
                                                <TextBlock FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,2">
                                                    <Run Text="💡 Сетап отряда: " FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                                                    <Run Text="{Binding RecommendedSetup, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap">
                                                    <Run Text="📌 Совет: " FontWeight="SemiBold" Foreground="{StaticResource BrushGold}"/>
                                                    <Run Text="{Binding FarmingTip, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Row 5: LFG Copy -->
                                            <Grid Grid.Row="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding LfgCopyText}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Content="📋 Скопировать LFG"
                                                        Command="{Binding DataContext.CopyLfgCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource WarfButton}" Padding="10,4" FontSize="10"
                                                        ToolTip="Скопировать текст набора для игрового чата [Рекрутинг]"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
