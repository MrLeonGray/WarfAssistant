<UserControl x:Class="WarfAssistant.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:WarfAssistant.Controls"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             d:DesignHeight="790" d:DesignWidth="1160">
    <UserControl.Resources>
        <!-- Crisp Warframe HUD Vector Geometries (auto-overridden if PNGs are placed in data/assets/ui/) -->
        <Geometry x:Key="BellGeometry">M12,2A2,2 0 0,0 10,4C10,4.28 10.06,4.54 10.17,4.78C7.79,5.57 6,7.81 6,10.5V16L4,18V19H20V18L18,16V10.5C18,7.81 16.21,5.57 13.83,4.78C13.94,4.54 14,4.28 14,4A2,2 0 0,0 12,2M10,20A2,2 0 0,0 12,22A2,2 0 0,0 14,20H10Z</Geometry>
        <Geometry x:Key="ClockGeometry">M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 1,1 20,12A8,8 0 0,1 12,20M12.5,7H11V13L16.2,16.1L17,14.9L12.5,12.2V7Z</Geometry>

        <Geometry x:Key="NavTradersGeometry">M12,2 L17.6,18.8 L15.2,20.5 L12,10.8 L8.8,20.5 L6.4,18.8 Z M12,14.2 L14,19.3 L12,21 L10,19.3 Z</Geometry>
        <Geometry x:Key="NavInvasionsGeometry">M3,12.5 L12,5.5 L21,12.5 L19.2,14.5 L12,8.8 L4.8,14.5 Z M3,18 L12,11 L21,18 L19.2,20 L12,14.3 L4.8,20 Z</Geometry>
        <Geometry x:Key="NavFissuresGeometry">M12.6,2 C10.4,5.8 14.8,8.2 13.9,12.2 C15.7,10.9 16.5,9.3 16.2,7 C19.1,9.6 19.6,14 17.3,17.4 C15.7,19.7 13.6,21 11.6,21 C8.1,21 5.7,18.2 5.7,14.5 C5.7,10.6 8.5,7.4 12.6,2 Z</Geometry>
        <Geometry x:Key="NavSortieGeometry">M12,3 L14.5,6.7 L12,10.4 L9.5,6.7 Z M7,9.2 L9.5,12.8 L7,16.4 L4.5,12.8 Z M17,9.2 L19.5,12.8 L17,16.4 L14.5,12.8 Z M12,13 L15,17.3 L12,21.5 L9,17.3 Z</Geometry>
        <Geometry x:Key="NavArchonGeometry">M12,2 L15,7 L19,10.5 L13.8,12.5 L12,22 L10.2,12.5 L5,10.5 L9,7 Z M12,5.5 L10.5,9.5 L12,13.5 L13.5,9.5 Z</Geometry>
        <Geometry x:Key="HexisCrestGeometry">M12,1.5 L13.7,7.6 L12,10.5 L10.3,7.6 Z M12,13.5 L13.7,16.4 L12,22.5 L10.3,16.4 Z M4.6,5.5 L10.3,10.3 L8.2,12.6 L3.3,8.5 Z M19.4,5.5 L20.7,8.5 L15.8,12.6 L13.7,10.3 Z M2.4,11.6 L8.4,11.6 L9.9,13.4 L3.4,13.4 Z M21.6,11.6 L20.6,13.4 L14.1,13.4 L15.6,11.6 Z M4.8,18.2 L8.6,14.6 L10.1,16.4 L6.3,20.2 Z M19.2,18.2 L17.7,20.2 L13.9,16.4 L15.4,14.6 Z</Geometry>

        <!-- Fissure Mission Category Chevrons & Railjack Icon -->
        <Geometry x:Key="FissureOriginChevron">M2,11 L8,5 L14,11 L12.4,12.5 L8,8.2 L3.6,12.5 Z</Geometry>
        <Geometry x:Key="FissureSteelPathChevrons">M2,7 L8,2.5 L14,7 L12.5,8.2 L8,4.8 L3.5,8.2 Z M2,10.8 L8,6.3 L14,10.8 L12.5,12 L8,8.6 L3.5,12 Z M2,14.6 L8,10.1 L14,14.6 L12.5,15.8 L8,12.4 L3.5,15.8 Z</Geometry>
        <Geometry x:Key="FissureRailjackGeometry">M12,1.5 L14.5,7 L21,12.5 L19.5,14.5 L14.5,12.5 L14,17.5 L16.5,20.5 L14.5,21.5 L12,18.5 L9.5,21.5 L7.5,20.5 L10,17.5 L9.5,12.5 L4.5,14.5 L3,12.5 L9.5,7 Z</Geometry>

        <!-- Nightwave HUD Vector Glyphs -->
        <Geometry x:Key="NightwaveMicGeometry">M12,2A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z</Geometry>
        <Geometry x:Key="NightwaveActCrestGeometry">M12,2 L21,7 L12,22 L3,7 Z M12,5.2 L6.5,8.2 L12,17.4 L17.5,8.2 Z M12,8 L14.5,10.5 L12,13.5 L9.5,10.5 Z</Geometry>
        <Geometry x:Key="NightwaveStandingGeometry">M12,2 L19,7.5 L16.2,20 L7.8,20 L5,7.5 Z M12,6.2 L8.8,9 L10.2,16.5 L13.8,16.5 L15.2,9 Z</Geometry>

        <!-- Uniform Docked Top-Right Navigation Icon Cell (ALL 7 buttons share identical 48x36 size -> 338x38 total) -->
        <Style x:Key="NavWorldIconButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CellBd" Background="#EB090C11" BorderBrush="#2C3442" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="ActiveFrame" BorderBrush="Transparent" BorderThickness="1" Margin="1"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CountTxt"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0}'}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,2,4,0" FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="#E3E9F2"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=CountTxt}" Value="">
                                <Setter TargetName="CountTxt" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=CountTxt}" Value="0">
                                <Setter TargetName="CountTxt" Property="Foreground" Value="#636E80"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CellBd" Property="Background" Value="#1B222E"/>
                                <Setter TargetName="ActiveFrame" Property="BorderBrush" Value="#8E96A6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CellBd" Property="Background" Value="#212938"/>
                                <Setter TargetName="ActiveFrame" Property="BorderBrush" Value="#E8ECF4"/>
                                <Setter TargetName="CountTxt" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Warframe Sub-Tab Style -->
        <Style x:Key="StarChartSubTabStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#0D1118" BorderBrush="#2C3544" BorderThickness="1" Padding="11,5.5">
                            <Grid>
                                <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#8B96A8" VerticalAlignment="Center"/>
                                <Rectangle x:Name="Line" Height="2" VerticalAlignment="Bottom" Margin="-11,0,-11,-5.5"
                                           Fill="{StaticResource BrushGold}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#151C28"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5C677A"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="#E5EAF2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#171E2B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9E7F3B"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="#F3F6FA"/>
                                <Setter TargetName="Line" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sharp Game Filter Chip (for Relic Tiers & Mission Modes) -->
        <Style x:Key="StarChartFilterButton" TargetType="Button">
            <Setter Property="Background" Value="#0C1017"/>
            <Setter Property="Foreground" Value="#A5B2C6"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBd" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter TargetName="ChipBd" Property="Background" Value="#151D2B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="1">
                                <Setter TargetName="ChipBd" Property="Background" Value="#1B283A"/>
                                <Setter TargetName="ChipBd" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Virtualized Borderless ListBox -->
        <Style x:Key="CleanListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#07090D" Margin="10,8">
        <!-- =============================================================== -->
        <!-- LAYER 0: FULL-WIDTH BASE WORKSPACE (TIMERS, ENDGAME 1999, NEWS) -->
        <!-- =============================================================== -->
        <Grid Panel.ZIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 5 Open World Timers Strip: exact 38px height matching Top-Right 7 HUD buttons (338x38), exact 8px gutter -->
            <Grid Grid.Row="0" Margin="0,0,346,0">
                <ItemsControl ItemsSource="{Binding WorldCycles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" Margin="0,0,-6,0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0B0F16" BorderBrush="#2C3544" BorderThickness="1" Height="38" Padding="7,2,5,2" Margin="0,0,6,0" ToolTip="{Binding FullToolTip}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding DataContext.ToggleCycleNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Cursor="Hand" ToolTip="{Binding NotifyTarget}" Margin="4,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BellBd" Background="#131924" BorderBrush="#334054" BorderThickness="1" Width="14" Height="14">
                                                        <Path Data="{StaticResource BellGeometry}" Width="8" Height="8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Fill" Value="#7A889E"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding NotifyEnabled}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource BrushGoldBright}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding NotifyEnabled}" Value="True">
                                                            <Setter TargetName="BellBd" Property="Background" Value="#2A200D"/>
                                                            <Setter TargetName="BellBd" Property="BorderBrush" Value="{StaticResource BrushGold}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock Text="{Binding LocationName}" FontSize="9.5" FontWeight="SemiBold" Foreground="#DCE3EE"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel Grid.Row="1" Margin="0,1,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeRemaining}" FontSize="10.5" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <TextBlock Text="{Binding State}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Base Body: Endgame 1999/Archimedea/Steel Path Left + Official News & Bottom HUD Right -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Endgame & Weekly Rotations with Warframe Sub-Tabs -->
                <Border Grid.Column="0" Background="#0A0E15" BorderBrush="#2D3646" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Sub-Tab Strip + Live Weekly Reset Timer -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,9">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Path Data="{StaticResource ClockGeometry}" Width="11" Height="11" Stretch="Uniform" Fill="#7E8CA2" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding ActiveEndgameTimeRemaining}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal">
                                <RadioButton Content="АРХИМЕДИИ" GroupName="EndgameSubTabs" Style="{StaticResource StarChartSubTabStyle}"
                                             IsChecked="{Binding EndgameSubTab, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Archimedea}"
                                             Command="{Binding SwitchEndgameSubTabCommand}" CommandParameter="Archimedea"/>
                                <RadioButton Content="СПУСК" GroupName="EndgameSubTabs" Style="{StaticResource StarChartSubTabStyle}"
                                             IsChecked="{Binding EndgameSubTab, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Descendia}"
                                             Command="{Binding SwitchEndgameSubTabCommand}" CommandParameter="Descendia"/>
                                <RadioButton Content="1999 ХЕКС" GroupName="EndgameSubTabs" Style="{StaticResource StarChartSubTabStyle}"
                                             IsChecked="{Binding EndgameSubTab, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Calendar}"
                                             Command="{Binding SwitchEndgameSubTabCommand}" CommandParameter="Calendar"/>
                                <RadioButton Content="СТАЛЬНОЙ ПУТЬ" GroupName="EndgameSubTabs" Style="{StaticResource StarChartSubTabStyle}" Margin="0"
                                             IsChecked="{Binding EndgameSubTab, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=SteelPath}"
                                             Command="{Binding SwitchEndgameSubTabCommand}" CommandParameter="SteelPath"/>
                            </WrapPanel>
                        </DockPanel>

                        <!-- SUB-TAB 1: ARCHIMEDEAS (Deep + Temporal) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EndgameSubTab}" Value="Archimedea">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding Archimedeas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D121B" BorderBrush="#293447" BorderThickness="1" Margin="0,0,0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Fill="{Binding AccentColor}"/>
                                                <StackPanel Grid.Column="1" Margin="10,9">
                                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding AccentColor}" TextWrapping="Wrap" Margin="0,0,0,7"/>

                                                    <!-- 3 Structured Mission Cards -->
                                                    <ItemsControl ItemsSource="{Binding Missions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#090D14" BorderBrush="#202B3D" BorderThickness="1" Padding="8,6" Margin="0,0,0,5">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                                            <Border DockPanel.Dock="Right" Background="#1E1A0F" BorderBrush="#7A5F22" BorderThickness="1"
                                                                                    Padding="6,1.5" ToolTip="{Binding DeviationDesc}" Cursor="Help">
                                                                                <TextBlock Text="{Binding DeviationName}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                                                                            </Border>
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Index, StringFormat='{}{0}.'}" FontSize="10.5" FontWeight="ExtraBold" Foreground="{StaticResource BrushGold}" Margin="0,0,5,0"/>
                                                                                <TextBlock Text="{Binding MissionType}" FontSize="10.5" FontWeight="Bold" Foreground="#F1F5F9"/>
                                                                                <TextBlock Text="{Binding Faction, StringFormat=' ({0})'}" FontSize="9.5" Foreground="#7E8CA2" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </DockPanel>

                                                                        <!-- Discrete Risk Chips -->
                                                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Risks}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel Orientation="Horizontal"/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Background="#221116" BorderBrush="#692634" BorderThickness="1" Padding="6,1.5" Margin="0,0,4,2">
                                                                                        <TextBlock Text="{Binding}" FontSize="8.5" Foreground="#FCA5A5"/>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Personal Modifiers Section -->
                                                    <StackPanel Margin="0,3,0,0">
                                                        <TextBlock Text="ЛИЧНЫЕ МОДИФИКАТОРЫ" FontSize="8.5" FontWeight="Bold" Foreground="#7D899D" Margin="0,0,0,4"/>
                                                        <ItemsControl ItemsSource="{Binding PersonalModifiers}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#181326" BorderBrush="#4C3575" BorderThickness="1" Padding="7,2.5" Margin="0,0,4,4"
                                                                            Cursor="Help" ToolTip="{Binding Description}">
                                                                        <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="SemiBold" Foreground="#DDD6FE"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- SUB-TAB 2: DESCENDIA (21 Floors Tower with Milestones & Russian Mission Types) -->
                        <Grid Grid.Row="1">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EndgameSubTab}" Value="Descendia">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#0D121B" BorderBrush="#283548" BorderThickness="1" Padding="9,6" Margin="0,0,0,7">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Чекпоинты: #7, #14  •  Финал: #21" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="НИСХОЖДЕНИЕ (21 ЭТАЖ)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Descendia.Challenges}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" BorderBrush="{Binding RowBorder}" BorderThickness="1"
                                                    Padding="8,4.5" Margin="0,0,0,3" ToolTip="{Binding DetailTooltip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='#{0}'}" FontSize="9.5" FontWeight="Bold"
                                                               Foreground="{StaticResource BrushGold}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ChallengeName}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="#EEF2F8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" Background="#161D2A" BorderBrush="{Binding BadgeColor}" BorderThickness="1"
                                                            Padding="5,0.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding BadgeLabel}" FontSize="8" FontWeight="Bold" Foreground="{Binding BadgeColor}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="{Binding MissionType}" FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrushCyan}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- SUB-TAB 3: 1999 HEX CALENDAR (Structured Cards: Prizes / Buffs / Tasks) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EndgameSubTab}" Value="Calendar">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <Border Background="#0D1917" BorderBrush="#1F5143" BorderThickness="1" Padding="9,6" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding HexCalendar.SeasonDisplay}" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>

                                <!-- Big Prizes (2-column compact gold cards) -->
                                <TextBlock Text="БОЛЬШИЕ ПРИЗЫ" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushGold}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding HexCalendar.Prizes}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" Margin="0,0,-5,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A160D" BorderBrush="#755A1D" BorderThickness="1" Padding="8,5" Margin="0,0,5,5">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DateLabel}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushGold}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Overrides / Buffs (2-column emerald cards) -->
                                <TextBlock Text="БАФФЫ (ПЕРЕОПРЕДЕЛЕНИЯ)" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding HexCalendar.Overrides}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" Margin="0,0,-5,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0B1915" BorderBrush="#1D5142" BorderThickness="1" Padding="8,5" Margin="0,0,5,5"
                                                    Cursor="Help" ToolTip="{Binding Detail}">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DateLabel}" FontSize="8.5" Foreground="#648A7F"/>
                                                        <TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="Bold" Foreground="#6EE7B7" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Detail}" FontSize="8.5" Foreground="#98B2AC" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Hex Tasks (2-column cyan cards) -->
                                <TextBlock Text="ЗАДАНИЯ ХЕКСА" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding HexCalendar.Tasks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" Margin="0,0,-5,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0B131E" BorderBrush="#213852" BorderThickness="1" Padding="8,5" Margin="0,0,5,5"
                                                    Cursor="Help" ToolTip="{Binding Detail}">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DateLabel}" FontSize="8.5" Foreground="#647B96"/>
                                                        <TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Detail}" FontSize="8.5" Foreground="#8FA0B5" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- SUB-TAB 4: STEEL PATH (TESHIN — Hero Card + 2-Column 8-Week Rotation Grid) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EndgameSubTab}" Value="SteelPath">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <Border Background="#13251B" BorderBrush="{StaticResource BrushSuccessGreen}" BorderThickness="1" Padding="11,9" Margin="0,0,0,10">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="#251F11" BorderBrush="#9E7F3B" BorderThickness="1" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SteelPath.CurrentRewardCost, StringFormat='{}{0} Эссенции'}"
                                                       FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="ПОЧЕСТИ ТЕШИНА • ТЕКУЩАЯ НЕДЕЛЯ" FontSize="8.5" FontWeight="Bold" Foreground="#6EE7B7"/>
                                            <TextBlock Text="{Binding SteelPath.CurrentRewardName}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="РОТАЦИЯ (8 НЕДЕЛЬ)" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding SteelPath.Rotation}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" Margin="0,0,-6,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" BorderBrush="{Binding RowBorder}" BorderThickness="1"
                                                    Padding="9,7" Margin="0,0,6,6">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Index, StringFormat='#{0}'}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Cost, StringFormat='{}{0} Эсс.'}" FontSize="9.5" FontWeight="Bold"
                                                               Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#EEF2F8"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- RIGHT BASE: Official News + Aligned Bottom Strip (Simaris/Veil + Nightwave) -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="88"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0A0E15" BorderBrush="#2D3646" BorderThickness="1" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ОФИЦИАЛЬНЫЕ НОВОСТИ И ОБНОВЛЕНИЯ" FontSize="10.5" FontWeight="Bold" Foreground="#D8DCE5" Margin="0,0,0,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding NewsItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" VerticalAlignment="Top" Margin="0,0,-8,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenNewsLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding LinkUrl}" Cursor="Hand" Margin="0,0,8,8"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                    ToolTip="{Binding Title}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ctrl:AspectRatioDecorator AspectRatio="1.7777778">
                                                            <Border x:Name="NBd" Background="#0D131D" BorderBrush="#2C394E"
                                                                    BorderThickness="1" ClipToBounds="True">
                                                                <Grid>
                                                                    <Image Source="{Binding BannerBitmap}" Stretch="UniformToFill" Opacity="0.90"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    <Border>
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="#1406090E" Offset="0.0"/>
                                                                                <GradientStop Color="#8E070B12" Offset="0.60"/>
                                                                                <GradientStop Color="#F0070B12" Offset="1.0"/>
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <Grid Margin="8,6">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="*"/>
                                                                        </Grid.RowDefinitions>
                                                                        <Grid Grid.Row="0">
                                                                            <Border Background="{Binding CategoryColor}" Padding="5,1" HorizontalAlignment="Left">
                                                                                <TextBlock Text="{Binding CategoryLabel}" FontSize="8" FontWeight="Bold" Foreground="#090D14"/>
                                                                            </Border>
                                                                            <Border Background="#BD070B12" Padding="5,1" HorizontalAlignment="Right">
                                                                                <TextBlock Text="{Binding DateDisplay}" FontSize="8.5" FontWeight="SemiBold" Foreground="#DCE7F5"/>
                                                                            </Border>
                                                                        </Grid>
                                                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="10" FontWeight="Bold"
                                                                                   Foreground="#FFFFFF" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                                   MaxHeight="40" VerticalAlignment="Bottom"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </ctrl:AspectRatioDecorator>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="NBd" Property="BorderBrush" Value="#E2E8F0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- SYMMETRICAL BOTTOM DOCK (88px): Left = Duviri (56) + Simaris/Veil (28) | 8px | Right = Nightwave (56) + Refresh/Reset (28) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT HALF: Duviri Banner (56px, exact same size as Nightwave) + 4px + Simaris & Veil (28px, exact same height as Refresh/Reset) -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>

                            <RadioButton Grid.Row="0" GroupName="NavHudTopTabs" Cursor="Hand" Height="56"
                                         IsChecked="{Binding ActiveHudPanel, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Duviri}"
                                         Command="{Binding SelectHudPanelCommand}" CommandParameter="Duviri"
                                         ToolTip="Открыть Спираль Дувири и ротации Цепи (Недели 1–9)">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="DuvBd" BorderBrush="#5F6777" BorderThickness="1" ClipToBounds="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1F2E28" Offset="0.0"/>
                                                    <GradientStop Color="#151D29" Offset="0.52"/>
                                                    <GradientStop Color="#0B0F17" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Image Source="{Binding UiIconDuviriBanner}" Stretch="UniformToFill" Opacity="0.88"
                                                       Visibility="{Binding HasUiIconDuviriBanner, Converter={StaticResource BoolToVis}}"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#20080C12" Offset="0.0"/>
                                                            <GradientStop Color="#C4080C12" Offset="0.6"/>
                                                            <GradientStop Color="#EC080C12" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Grid Margin="10,0,12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center" Margin="0,0,8,0"
                                                          Visibility="{Binding HasUiIconDuviriBanner, Converter={StaticResource InverseBoolToVis}}">
                                                        <Ellipse Stroke="#88A899" StrokeThickness="1.4" Width="40" Height="40" Fill="#121D1A"/>
                                                        <Polygon Points="21,7 28,15 25,28 21,34 17,28 14,15" Stroke="#D4C79A" StrokeThickness="1.3" Fill="#1E2C27"/>
                                                        <Ellipse Fill="#67E8F9" Width="5" Height="5" VerticalAlignment="Top" Margin="0,17,0,0"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                                                        <TextBlock Text="ДУВИРИ • РОТАЦИИ ЦЕПИ" FontSize="12" FontWeight="ExtraBold" Foreground="#F8FAFC"
                                                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                        <DockPanel Margin="0,1,0,0">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DuviriMood.TimeRemaining, StringFormat=' • {0}'}"
                                                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushGoldBright}"/>
                                                            <TextBlock Text="{Binding DuviriMood.CurrentMood}" FontSize="10" Foreground="{StaticResource BrushCyan}"
                                                                       TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DuvBd" Property="BorderBrush" Value="#C8D0DC"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="DuvBd" Property="BorderBrush" Value="#F1F5F9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- Simaris & Veil (2 equal 28px cells, matching Refresh/Reset right beside them) -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Height="28" Background="#0B1416" BorderBrush="#29544C" BorderThickness="1"
                                        Cursor="Help" ToolTip="{Binding SimarisLocationTooltip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#10B981"/>
                                        <TextBlock Grid.Column="1" FontSize="9.5" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Margin="5,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="СИМЭРИС: " Foreground="#7A8E9E" FontWeight="Bold"/>
                                            <Run Text="{Binding SimarisTarget, Mode=OneWay}" Foreground="#A7F3D0" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Height="28" Background="#100E1B" BorderBrush="#3E3263" BorderThickness="1"
                                        Cursor="Help" ToolTip="Активная аномалия Владеющих Разумом (корабль Мьюрекс) в Проксиме Вуали (Рэйлджек)">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#A855F7"/>
                                        <TextBlock Grid.Column="1" FontSize="9.5" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Margin="5,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="ВУАЛЬ: " Foreground="#8884A3" FontWeight="Bold"/>
                                            <Run Text="{Binding SentientOutpostText, Mode=OneWay}" Foreground="#DDD6FE" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- RIGHT HALF: Nightwave Banner (56px, exact same size as Duviri) + 4px + Action Strip (28px) -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Command="{Binding ToggleNightwaveCommand}" Cursor="Hand" Height="56" ToolTip="Открыть окно Ночной Волны">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NwBd" BorderBrush="#5F6777" BorderThickness="1" ClipToBounds="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#1F1634" Offset="0.0"/>
                                                    <GradientStop Color="#121420" Offset="0.45"/>
                                                    <GradientStop Color="#0B0D12" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Path Data="M60,28 Q95,12 130,28 T200,28 T270,28 T340,28" Stroke="#2D3D5A" StrokeThickness="1.3" Opacity="0.5"/>
                                                <Grid Margin="10,0,12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <Image Source="{Binding UiIconNightwave}" Stretch="Uniform"
                                                               Visibility="{Binding HasUiIconNightwave, Converter={StaticResource BoolToVis}}"/>
                                                        <Grid Visibility="{Binding HasUiIconNightwave, Converter={StaticResource InverseBoolToVis}}">
                                                            <Ellipse Stroke="#C084FC" StrokeThickness="1.5" StrokeDashArray="3,2" Width="40" Height="40" Opacity="0.7"/>
                                                            <Ellipse Fill="#0E121B" Stroke="#67E8F9" StrokeThickness="1.8" Width="28" Height="28"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Rectangle Width="2" Height="10" Fill="#67E8F9" Margin="1,0"/>
                                                                <Rectangle Width="2" Height="16" Fill="#E879F9" Margin="1,0"/>
                                                                <Rectangle Width="2" Height="12" Fill="#38BDF8" Margin="1,0"/>
                                                                <Rectangle Width="2" Height="18" Fill="#A855F7" Margin="1,0"/>
                                                                <Rectangle Width="2" Height="9" Fill="#67E8F9" Margin="1,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                                                        <TextBlock Text="НОЧНАЯ ВОЛНА" FontSize="12" FontWeight="ExtraBold" Foreground="#F8FAFC" HorizontalAlignment="Right"/>
                                                        <DockPanel ToolTip="{Binding Nightwave.SeasonExpiryHint}" Margin="0,1,0,0">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Nightwave.TimeRemaining, StringFormat=' • ~{0}'}"
                                                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushGoldBright}"/>
                                                            <TextBlock Text="{Binding Nightwave.SeasonTitle}" FontSize="10" Foreground="#C4CEDC"
                                                                       TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NwBd" Property="BorderBrush" Value="#E2E8F0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding RefreshWorldstateCommand}" Cursor="Hand" Height="28" ToolTip="Обновить живые данные Worldstate">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBd" Background="#EB090C11" BorderBrush="#4E5666" BorderThickness="1" Padding="5,0">
                                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                                    <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#DCE3EE" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="↻ ОБНОВИТЬ WORLDSTATE"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                                                        <Setter Property="Text" Value="⏳ ОБНОВЛЕНИЕ..."/>
                                                                        <Setter Property="Foreground" Value="{StaticResource BrushGoldBright}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBd" Property="Background" Value="#1A212E"/>
                                                    <Setter TargetName="BtnBd" Property="BorderBrush" Value="#B4BAC7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Border Grid.Column="2" Background="#EB090C11" BorderBrush="#4E5666" BorderThickness="1" Height="28" Padding="5,0"
                                        ToolTip="Таймер до ежедневного (00:00 UTC) / еженедельного (пн 00:00 UTC) сброса">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#C4CEDC" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Run Text="СБРОС: "/>
                                            <Run Text="{Binding DailyResetRemaining, Mode=OneWay}" Foreground="{StaticResource BrushCyan}" FontWeight="Bold"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding WeeklyResetRemaining, Mode=OneWay}" Foreground="{StaticResource BrushGoldBright}" FontWeight="Bold"/>
                                        </TextBlock>
                                    </Viewbox>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- =============================================================== -->
        <!-- LAYER 1A: TOP-RIGHT UNIFORM DOCKED BAR (338x38 EXACT, Z=25)     -->
        <!-- =============================================================== -->
        <Border Panel.ZIndex="25" HorizontalAlignment="Right" VerticalAlignment="Top"
                Height="38" Background="#EB090C11" BorderBrush="#6B7382" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <!-- 1. Void Traders: Baro Ki'Teer & Varzia (NO NUMBER) -->
                <RadioButton GroupName="NavHudTopTabs" Style="{StaticResource NavWorldIconButtonStyle}" Tag=""
                             IsChecked="{Binding ActiveHudPanel, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Traders}"
                             Command="{Binding SelectHudPanelCommand}" CommandParameter="Traders"
                             ToolTip="Торговцы Бездны: Баро Ки'Тиир и Варзия">
                    <Grid Width="20" Height="20">
                        <Image Source="{Binding UiIconNavTraders}" Stretch="Uniform"
                               Visibility="{Binding HasUiIconNavTraders, Converter={StaticResource BoolToVis}}"/>
                        <Path Data="{StaticResource NavTradersGeometry}" Fill="#D6DDE8" Stretch="Uniform" Width="16" Height="18"
                              Visibility="{Binding HasUiIconNavTraders, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </RadioButton>

                <!-- 2. Events, Weekend Boosters & Discounts (NO NUMBER; green indicator dot if active booster) -->
                <RadioButton GroupName="NavHudTopTabs" Style="{StaticResource NavWorldIconButtonStyle}" Tag=""
                             IsChecked="{Binding ActiveHudPanel, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Events}"
                             Command="{Binding SelectHudPanelCommand}" CommandParameter="Events"
                             ToolTip="События, Операции, Баффы выходного дня и Скидки">
                    <Grid Width="24" Height="22">
                        <Image Source="{Binding UiIconNavEvents}" Stretch="Uniform"
                               Visibility="{Binding HasUiIconNavEvents, Converter={StaticResource BoolToVis}}"/>
                        <Grid Visibility="{Binding HasUiIconNavEvents, Converter={StaticResource InverseBoolToVis}}">
                            <Ellipse Stroke="#DCE2EC" StrokeThickness="1.3" Width="18" Height="18"/>
                            <Polygon Points="8,5 16,8 14,17 6,14" Stroke="#DCE2EC" StrokeThickness="1.3" Fill="Transparent"/>
                        </Grid>
                        <Polygon Points="3.5,0 7,3.5 3.5,7 0,3.5" Fill="#34D399" Stroke="#071510" StrokeThickness="0.6"
                                 Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Visibility="{Binding HasGlobalBoosters, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </RadioButton>

                <!-- 3. Alerts & Arbitration -->
                <RadioButton GroupName="NavHudTopTabs" Style="{StaticResource NavWorldIconButtonStyle}"
                             Tag="{Binding HudAlertsCount}"
                             IsChecked="{Binding ActiveHudPanel, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Alerts}"
                             Command="{Binding SelectHudPanelCommand}" CommandParameter="Alerts"
                             ToolTip="Сигналы Тревоги (и Арбитраж)">
                    <Grid Width="20" Height="20">
                        <Image Source="{Binding UiIconNavAlerts}" Stretch="Uniform"
                               Visibility="{Binding HasUiIconNavAlerts, Converter={StaticResource BoolToVis}}"/>
                        <Grid Visibility="{Binding HasUiIconNavAlerts, Converter={StaticResource InverseBoolToVis}}">
                            <Polygon Points="10,2 19,18 1,18" Stroke="#E2E7EF" StrokeThickness="1.5" StrokeLineJoin="Miter"/>
                            <Rectangle Width="2" Height="6" Fill="#E2E7EF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0"/>
                            <Rectangle Width="2" Height="2" Fill="#E2E7EF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14.5,0,0"/>
                        </Grid>
                    </Grid>
                </RadioButton>

                <!-- 4. Invasions & Construction Progress -->
                <RadioButton GroupName="NavHudTopTabs" Style="{StaticResource NavWorldIconButtonStyle}"
                             Tag="{Binding HudInvasionsCount}"
                             IsChecked="{Binding ActiveHudPanel, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Invasions}"
                             Command="{Binding SelectHudPanelCommand}" CommandParameter="Invasions"
                             ToolTip="Вторжения и угрозы системе">
                    <Grid Width="20" Height="20">
                        <Image Source="{Binding UiIconNavInvasions}" Stretch="Uniform"
                               Visibility="{Binding HasUiIconNavInvasions, Converter={StaticResource BoolToVis}}"/>
                        <Path Data="{StaticResource NavInvasionsGeometry}" Fill="#D6DDE8" Stretch="Uniform" Width="18" Height="18"
                              Visibility="{Binding HasUiIconNavInvasions, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </RadioButton>

                <!-- 5. Void Fissures (Relics) -->
                <RadioButton GroupName="NavHudTopTabs" Style="{StaticResource NavWorldIconButtonStyle}"
                             Tag="{Binding HudFissuresCount}"
                             IsChecked="{Binding ActiveHudPanel, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Fissures}"
                             Command="{Binding SelectHudPanelCommand}" CommandParameter="Fissures"
                             ToolTip="Разрывы Бездны (Реликвии)">
                    <Grid Width="20" Height="20">
                        <Image Source="{Binding UiIconNavFissures}" Stretch="Uniform"
                               Visibility="{Binding HasUiIconNavFissures, Converter={StaticResource BoolToVis}}"/>
                        <Path Data="{StaticResource NavFissuresGeometry}" Fill="#D6DDE8" Stretch="Uniform" Width="16" Height="18"
                              Visibility="{Binding HasUiIconNavFissures, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </RadioButton>

                <!-- 6. Daily Sortie (always 3 stages, no count badge) -->
                <RadioButton GroupName="NavHudTopTabs" Style="{StaticResource NavWorldIconButtonStyle}"
                             Tag=""
                             IsChecked="{Binding ActiveHudPanel, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Sortie}"
                             Command="{Binding SelectHudPanelCommand}" CommandParameter="Sortie"
                             ToolTip="Вылазка дня">
                    <Grid Width="20" Height="20">
                        <Image Source="{Binding UiIconNavSortie}" Stretch="Uniform"
                               Visibility="{Binding HasUiIconNavSortie, Converter={StaticResource BoolToVis}}"/>
                        <Path Data="{StaticResource NavSortieGeometry}" Fill="#D6DDE8" Stretch="Uniform" Width="18" Height="18"
                              Visibility="{Binding HasUiIconNavSortie, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </RadioButton>

                <!-- 7. Archon Hunt (always 3 stages, no count badge) -->
                <RadioButton GroupName="NavHudTopTabs" Style="{StaticResource NavWorldIconButtonStyle}"
                             BorderThickness="0"
                             Tag=""
                             IsChecked="{Binding ActiveHudPanel, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Archon}"
                             Command="{Binding SelectHudPanelCommand}" CommandParameter="Archon"
                             ToolTip="Охота на Архонта">
                    <Grid Width="20" Height="20">
                        <Image Source="{Binding UiIconNavArchon}" Stretch="Uniform"
                               Visibility="{Binding HasUiIconNavArchon, Converter={StaticResource BoolToVis}}"/>
                        <Path Data="{StaticResource NavArchonGeometry}" Fill="#D6DDE8" Stretch="Uniform" Width="17" Height="19"
                              Visibility="{Binding HasUiIconNavArchon, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- =============================================================== -->
        <!-- LAYER 2: FLOATING OVERLAY DRAWER ("ОТКРЫВАЕТСЯ ПОВЕРХ")         -->
        <!-- =============================================================== -->
        <Grid Panel.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,46,0,96"
              Visibility="{Binding IsHudPanelOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#F7090C11" BorderBrush="#6F7887" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="520"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveHudPanel}" Value="Duviri">
                                <Setter Property="Width" Value="620"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Border Grid.Row="0" BorderBrush="#464E5C" BorderThickness="0,0,0,1" Padding="12,8" Background="#0D1118">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CloseHudPanelCommand}" Cursor="Hand" ToolTip="Закрыть окно">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseBd" Background="Transparent" BorderBrush="#39414E" BorderThickness="1" Padding="6,2">
                                            <TextBlock Text="✕" FontSize="10" Foreground="#94A0B4"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseBd" Property="Background" Value="#1E2532"/>
                                                <Setter TargetName="CloseBd" Property="BorderBrush" Value="#B0B8C5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="{Binding ActiveHudPanelTitle}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#ECEFF4" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Drawer Body -->
                    <Grid Grid.Row="1" Margin="10,8,10,10">
                        <!-- 1. TRADERS (BARO & VARZIA) -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveHudPanel}" Value="Traders">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="BtnTraderBaro" Content="БАРО КИ'ТИИР" GroupName="TraderSubTabs" IsChecked="True" Style="{StaticResource StarChartSubTabStyle}"/>
                                <RadioButton x:Name="BtnTraderVarzia" Content="ВАРЗИЯ: ВОЗРОЖДЕНИЕ ПРАЙМ" GroupName="TraderSubTabs" Style="{StaticResource StarChartSubTabStyle}"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Visibility="{Binding IsChecked, ElementName=BtnTraderBaro, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#0B0E14" BorderBrush="#414957" BorderThickness="1" Padding="10,7" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Baro.CharacterName}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                                            <TextBlock Text="{Binding Baro.Location}" FontSize="10" Foreground="{StaticResource BrushCyan}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Baro.StatusTitle}" FontSize="8.5" Foreground="#8895A7" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Baro.TimeRemaining}" FontSize="12" FontWeight="ExtraBold" Foreground="{StaticResource BrushGold}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Command="{Binding ToggleBaroNotifyCommand}" Cursor="Hand" VerticalAlignment="Center" ToolTip="Уведомление о Баро">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BaroBell" Background="#131924" BorderBrush="#334054" BorderThickness="1" Padding="5,4">
                                                        <Path Data="{StaticResource BellGeometry}" Width="12" Height="12" Stretch="Uniform">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Fill" Value="#94A3B8"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Baro.NotifyEnabled}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource BrushGoldBright}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Baro.NotifyEnabled}" Value="True">
                                                            <Setter TargetName="BaroBell" Property="Background" Value="#2D220D"/>
                                                            <Setter TargetName="BaroBell" Property="BorderBrush" Value="{StaticResource BrushGold}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Background="#080B10" BorderBrush="#2C3748" BorderThickness="1" Height="25" Padding="7,0" Margin="0,0,0,6">
                                    <Grid>
                                        <TextBox Text="{Binding BaroSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource BrushTextPrimary}" FontSize="10.5" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="{Binding Baro.SearchHint}" FontSize="9.5" Foreground="#5A677A" IsHitTestVisible="False" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BaroSearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="2" ItemsSource="{Binding DisplayBaroItems}" Style="{StaticResource CleanListBoxStyle}"
                                         Visibility="{Binding Baro.HasInventory, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0B0E14" BorderBrush="#2A3342" BorderThickness="1" Padding="7,4.5" Margin="0,0,0,3.5">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Ducats, StringFormat='{}{0} Дук.'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding Credits, StringFormat='{}{0:N0} Кр.'}" FontSize="9.5" Foreground="#8895A7"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding IconBitmap}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="2" Text="Баро сейчас в пути — список товаров появится по прибытии на реле."
                                           FontSize="10.5" Foreground="#7A869A" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Visibility="{Binding Baro.HasInventory, Converter={StaticResource InverseBoolToVis}}"/>
                            </Grid>

                            <Grid Grid.Row="1" Visibility="{Binding IsChecked, ElementName=BtnTraderVarzia, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#0B0E14" BorderBrush="#52401D" BorderThickness="1" Padding="9,6" Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Varzia.TimeRemaining}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="ВОЗРОЖДЕНИЕ ПРАЙМ (ВАРЗИЯ)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushGold}"/>
                                            <TextBlock Text="{Binding Varzia.CurrentRotationName}" FontSize="11.5" FontWeight="Bold" Foreground="#F1F5F9"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                                    <Button Content="За Корол. Айю" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterVarziaCommand}" CommandParameter="Regal"
                                            Tag="{Binding VarziaFilterMode, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Regal}"/>
                                    <Button Content="За Обычную Айю" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterVarziaCommand}" CommandParameter="Regular"
                                            Tag="{Binding VarziaFilterMode, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Regular}"/>
                                    <Button Content="Реликвии" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterVarziaCommand}" CommandParameter="Relics"
                                            Tag="{Binding VarziaFilterMode, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Relics}"/>
                                </WrapPanel>
                                <ListBox Grid.Row="2" ItemsSource="{Binding Varzia.DisplayItems}" Style="{StaticResource CleanListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0B0E14" BorderBrush="#2A3342" BorderThickness="1" Padding="7,4.5" Margin="0,0,0,3.5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{Binding ThumbnailBitmap}" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <StackPanel Grid.Column="1" Margin="7,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Category}" FontSize="8.5" Foreground="{StaticResource BrushCyan}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{Binding CostBg}" BorderBrush="{Binding CostBorder}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding CurrencyBitmap}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding CostShort}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding CostFg}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>

                        <!-- 2. EVENTS, BOOSTERS, DARVO & OPERATIONS -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveHudPanel}" Value="Events">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <TextBlock Text="БАФФЫ ВЫХОДНОГО ДНЯ И УСИЛИТЕЛИ" FontSize="10.5" FontWeight="SemiBold" Foreground="#98A2B3" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding GlobalBoosters}" Visibility="{Binding HasGlobalBoosters, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0E1E17" BorderBrush="#10B981" BorderThickness="1" Padding="10,7" Margin="0,0,0,4">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeRemaining}" FontSize="11" FontWeight="Bold" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                                                        <TextBlock Text="{Binding EffectText}" FontSize="11.5" FontWeight="Bold" Foreground="#ECFDF5"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="#0B0E14" BorderBrush="#313946" BorderThickness="1" Padding="10,7" Margin="0,0,0,10"
                                        Visibility="{Binding HasGlobalBoosters, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="Глобальных бустеров сейчас нет" FontSize="10.5" Foreground="#7A869A"/>
                                </Border>

                                <TextBlock Text="СКИДКА ДНЯ И ПРЕДЛОЖЕНИЯ (ДАРВО)" FontSize="10.5" FontWeight="SemiBold" Foreground="#98A2B3" Margin="0,0,0,4"/>
                                <Border Background="#0B0E14" BorderBrush="#523B1D" BorderThickness="1" Padding="10,8" Margin="0,0,0,10"
                                        Visibility="{Binding DarvoDeal.HasDeal, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource BrushGoldBright}" HorizontalAlignment="Right">
                                                <Run Text="{Binding DarvoDeal.SalePrice, Mode=OneWay}"/>
                                                <Run Text=" Пл"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DarvoDeal.OriginalPrice, StringFormat='Было: {0} Пл'}" FontSize="9" Foreground="#7A869A" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DarvoDeal.TimeRemaining}" FontSize="9.5" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Border Background="#B45309" Padding="5,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding DarvoDeal.DiscountPercent, StringFormat='-{0}%'}" FontSize="9" FontWeight="Bold" Foreground="#FFFBEB"/>
                                                </Border>
                                                <TextBlock Text="{Binding DarvoDeal.RemainingCount, StringFormat='Осталось: {0}'}" FontSize="9.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DarvoDeal.ItemName}" FontSize="11.5" FontWeight="Bold" Foreground="#F1F5F9"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Background="#0B0E14" BorderBrush="#313946" BorderThickness="1" Padding="10,7" Margin="0,0,0,10"
                                        Visibility="{Binding DarvoDeal.HasDeal, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="Скидки дня сейчас отсутствуют" FontSize="10.5" Foreground="#7A869A"/>
                                </Border>

                                <TextBlock Text="ОПЕРАЦИИ И СОБЫТИЯ" FontSize="10.5" FontWeight="SemiBold" Foreground="#98A2B3" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Operations}" Visibility="{Binding HasActiveOperations, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0B0E14" BorderBrush="#414957" BorderThickness="1" Padding="10,7" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeRemaining}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="#F1F5F9"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="#A4B2C5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,5,0,0"
                                                                 Background="#141923" Foreground="{StaticResource BrushGold}" BorderThickness="0"
                                                                 Visibility="{Binding HasCommunityProgress, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="#0B0E14" BorderBrush="#313946" BorderThickness="1" Padding="10,7"
                                        Visibility="{Binding HasActiveOperations, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="Активных глобальных операций сейчас нет" FontSize="10.5" Foreground="#7A869A"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 3. ALERTS + ARBITRATION + WEEKLY ALERTS -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveHudPanel}" Value="Alerts">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <TextBlock Text="АРБИТРАЖ" FontSize="10.5" FontWeight="SemiBold" Foreground="#98A2B3" Margin="0,0,0,4"/>
                                <Border Background="#0B0E14" BorderBrush="#414957" BorderThickness="1" Padding="10,9" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="46" Height="46" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <Image Source="{Binding UiIconArbitrationHexis}" Stretch="Uniform"
                                                   Visibility="{Binding HasUiIconArbitrationHexis, Converter={StaticResource BoolToVis}}"/>
                                            <Path Data="{StaticResource HexisCrestGeometry}" Fill="#F1F5F9" Stretch="Uniform" Width="44" Height="44"
                                                  Visibility="{Binding HasUiIconArbitrationHexis, Converter={StaticResource InverseBoolToVis}}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Text="{Binding Arbitration.MissionHeader}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Arbitration.FullLocation}" FontSize="11" Foreground="#C4CEDC" Margin="0,1,0,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                <Image Source="{Binding CreditsIconBitmap}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,4,0"/>
                                                <TextBlock Text="50 000 + " FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                <Polygon Points="6,0 11,5 9,12 3,12 1,5" Fill="#67E8F9" Stroke="#A5F3FC" StrokeThickness="0.8" Width="13" Height="13" Margin="1,1,5,0"/>
                                                <TextBlock Text="Эссенция Витус" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="#10151F" BorderBrush="#283140" BorderThickness="1" Padding="6,4" Margin="0,0,0,6">
                                                <TextBlock Text="Бонусы +300% к фрейму/оружию определяются игрой индивидуально для каждого аккаунта."
                                                           FontSize="9" Foreground="#8895A7" TextWrapping="Wrap"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource ClockGeometry}" Fill="#B6C0D0" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding Arbitration.TimeRemaining}" FontSize="10.5" FontWeight="SemiBold" Foreground="#D4DCE8"/>
                                                <TextBlock Text="{Binding Arbitration.SourceNote, StringFormat='  •  {0}'}" FontSize="9" Foreground="#697487" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Arbitration.SourceNote}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Grid.Column="2" Width="44" Height="44" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <Image Source="{Binding UiIconArbitrationBadge}" Stretch="Uniform"
                                                   Visibility="{Binding HasUiIconArbitrationBadge, Converter={StaticResource BoolToVis}}"/>
                                            <Grid Visibility="{Binding HasUiIconArbitrationBadge, Converter={StaticResource InverseBoolToVis}}">
                                                <Polygon Points="22,3 41,37 3,37" Fill="#16A34A" Stroke="#86EFAC" StrokeThickness="1.2"/>
                                                <Polygon Points="22,10 34,33 10,33" Fill="#0A120E"/>
                                                <Polygon Points="22,16 29,30 15,30" Fill="#22C55E"/>
                                                <Ellipse Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Top" Margin="0,22,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel Visibility="{Binding HasActiveAlertItems, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                    <TextBlock Text="АКТИВНЫЕ ТРЕВОГИ" FontSize="10.5" FontWeight="SemiBold" Foreground="#98A2B3" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0B0E14" BorderBrush="#414957" BorderThickness="1" Padding="10,7" Margin="0,0,0,4">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <Path Data="{StaticResource ClockGeometry}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding TimeRemaining}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Reward}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                                                            <TextBlock FontSize="10" Foreground="#B4C0D0">
                                                                <Run Text="{Binding MissionType, Mode=OneWay}"/>
                                                                <Run Text="{Binding Node, Mode=OneWay, StringFormat=' • {0}'}"/>
                                                                <Run Text="{Binding Planet, Mode=OneWay, StringFormat=' ({0})'}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Text="НЕДЕЛЬНЫЕ ТРЕВОГИ" FontSize="10.5" FontWeight="SemiBold" Foreground="#98A2B3" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding WeeklyChecklist}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ToggleWeeklyChecklistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="RowBd" Background="#0B0E14" BorderBrush="#39414E" BorderThickness="1" ClipToBounds="True">
                                                            <Grid>
                                                                <Polygon Points="85,0 0,32 85,64" Fill="#121721" HorizontalAlignment="Right" VerticalAlignment="Stretch" Stretch="Fill" Width="80"/>
                                                                <Grid Margin="8,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="38"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border x:Name="IconSq" Grid.Column="0" Width="32" Height="32" Background="#121822"
                                                                            BorderBrush="#364154" BorderThickness="1" VerticalAlignment="Center">
                                                                        <TextBlock x:Name="StateGlyph" Text="!" FontSize="14" FontWeight="Bold"
                                                                                   Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                                        <TextBlock x:Name="TitleTxt" Text="{Binding Title}" FontSize="11" FontWeight="Bold"
                                                                                   Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding RewardHint}" FontSize="9.5" Foreground="#98A4B8" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock x:Name="AvailTxt" Text="Доступно" FontSize="9.5" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                                              VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowBd" Property="BorderBrush" Value="#8F98A8"/>
                                                                <Setter TargetName="RowBd" Property="Background" Value="#121722"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter TargetName="RowBd" Property="Opacity" Value="0.62"/>
                                                                <Setter TargetName="IconSq" Property="Background" Value="#12261D"/>
                                                                <Setter TargetName="IconSq" Property="BorderBrush" Value="{StaticResource BrushSuccessGreen}"/>
                                                                <Setter TargetName="StateGlyph" Property="Text" Value="✓"/>
                                                                <Setter TargetName="StateGlyph" Property="Foreground" Value="{StaticResource BrushSuccessGreen}"/>
                                                                <Setter TargetName="AvailTxt" Property="Text" Value="Выполнено"/>
                                                                <Setter TargetName="AvailTxt" Property="Foreground" Value="{StaticResource BrushSuccessGreen}"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 4. INVASIONS: PINNED THREATS AT TOP, ONLY MISSIONS SCROLL BELOW -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveHudPanel}" Value="Invasions">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Pinned Invasion Construction Progress (Fomorian / Razorback) -->
                            <Border Grid.Row="0" Background="#0B0E14" BorderBrush="#414957" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="ПРОГРЕСС ВТОРЖЕНИЙ И УГРОЗ СИСТЕМЕ" FontSize="10" FontWeight="SemiBold" Foreground="#98A2B3" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Фоморианец Балор" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding Threats.FomorianPercent, Mode=OneWay}" Maximum="100" Height="6" Background="#141923" Foreground="#EF4444" BorderThickness="0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Threats.FomorianText}" FontSize="10" FontWeight="Bold" Foreground="#FCA5A5" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Армада Секачей" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding Threats.RazorbackPercent, Mode=OneWay}" Maximum="100" Height="6" Background="#141923" Foreground="#38BDF8" BorderThickness="0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Threats.RazorbackText}" FontSize="10" FontWeight="Bold" Foreground="#7DD3FC" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Scrollable Invasion Missions ONLY -->
                            <Grid Grid.Row="1">
                                <ListBox ItemsSource="{Binding ActiveInvasions}" Style="{StaticResource CleanListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0B0E14" BorderBrush="#3D4655" BorderThickness="1" Padding="9,7" Margin="0,0,0,5">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AttackerProgressPercent, StringFormat='{}{0:F1}%'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#F1F5F9">
                                                            <Run Text="{Binding Node, Mode=OneWay}"/>
                                                            <Run Text="{Binding Planet, Mode=OneWay, StringFormat=' ({0})'}" Foreground="#8E9AAE"/>
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Grid Width="22" Height="22" Margin="0,0,5,0">
                                                                <Image Source="{Binding AttackerBitmap}" Width="22" Height="22" Stretch="Uniform"/>
                                                                <TextBlock Text="{Binding AttackerRewardIcon}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding AttackerBitmap}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding AttackerFaction}" FontSize="8.5" Foreground="#8895A7"/>
                                                                <TextBlock Text="{Binding AttackerReward}" FontSize="9.5" FontWeight="Bold" Foreground="#FCA5A5" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="vs" FontSize="9" Foreground="#697589" VerticalAlignment="Center" Margin="4,0"/>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <StackPanel HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding DefenderFaction}" FontSize="8.5" Foreground="#8895A7" HorizontalAlignment="Right"/>
                                                                <TextBlock Text="{Binding DefenderReward}" FontSize="9.5" FontWeight="Bold" Foreground="#7DD3FC" TextTrimming="CharacterEllipsis" MaxWidth="170" HorizontalAlignment="Right"/>
                                                            </StackPanel>
                                                            <Grid Width="22" Height="22" Margin="5,0,0,0">
                                                                <Image Source="{Binding DefenderBitmap}" Width="22" Height="22" Stretch="Uniform"/>
                                                                <TextBlock Text="{Binding DefenderRewardIcon}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding DefenderBitmap}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ProgressBar Value="{Binding AttackerProgressPercent, Mode=OneWay}" Maximum="100" Height="4" Background="#1D3656" Foreground="#DC2626" BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Активных вторжений сейчас нет" FontSize="10.5" Foreground="#7A869A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveInvasions.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <!-- 5. VOID FISSURES (ONLY RELIC TIERS + ORIGIN/STEELPATH/PROXIMA) -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveHudPanel}" Value="Fissures">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#0B0E14" BorderBrush="#333C4B" BorderThickness="1" Padding="8,7,8,3" Margin="0,0,0,7">
                                <StackPanel>
                                    <!-- Row 1: Relic Dynasties (Лит / Мезо / Нео / Акси / Реквием / Омни) -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="Реликвии:" FontSize="9.5" Foreground="#7A869A" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                        <Button Content="Лит" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterFissureTierCommand}" CommandParameter="Lith"
                                                Tag="{Binding SelectedFissureTier, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Lith}"/>
                                        <Button Content="Мезо" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterFissureTierCommand}" CommandParameter="Meso"
                                                Tag="{Binding SelectedFissureTier, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Meso}"/>
                                        <Button Content="Нео" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterFissureTierCommand}" CommandParameter="Neo"
                                                Tag="{Binding SelectedFissureTier, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Neo}"/>
                                        <Button Content="Акси" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterFissureTierCommand}" CommandParameter="Axi"
                                                Tag="{Binding SelectedFissureTier, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Axi}"/>
                                        <Button Content="Реквием" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterFissureTierCommand}" CommandParameter="Requiem"
                                                Tag="{Binding SelectedFissureTier, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Requiem}"/>
                                        <Button Content="Омни" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterFissureTierCommand}" CommandParameter="Omnia"
                                                Tag="{Binding SelectedFissureTier, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Omnia}"/>
                                    </WrapPanel>

                                    <!-- Row 2: Mission Categories (Изначальная система [1 шеврон] / Стальной путь [3 шеврона] / Проксима [Рэйлджек]) -->
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="Режим:" FontSize="9.5" Foreground="#7A869A" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                        <Button Style="{StaticResource StarChartFilterButton}" Command="{Binding SetFissureCategoryCommand}" CommandParameter="Origin"
                                                Tag="{Binding FissureCategoryFilter, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Origin}">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="13" Height="13" Margin="0,0,5,0">
                                                    <Image Source="{Binding UiIconFissureOrigin}" Stretch="Uniform"
                                                           Visibility="{Binding HasUiIconFissureOrigin, Converter={StaticResource BoolToVis}}"/>
                                                    <Path Data="{StaticResource FissureOriginChevron}" Fill="#CBD5E1" Stretch="Uniform"
                                                          Visibility="{Binding HasUiIconFissureOrigin, Converter={StaticResource InverseBoolToVis}}"/>
                                                </Grid>
                                                <TextBlock Text="Изначальная система" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource StarChartFilterButton}" Command="{Binding SetFissureCategoryCommand}" CommandParameter="SteelPath"
                                                Tag="{Binding FissureCategoryFilter, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=SteelPath}">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="14" Height="14" Margin="0,0,5,0">
                                                    <Image Source="{Binding UiIconFissureSteelPath}" Stretch="Uniform"
                                                           Visibility="{Binding HasUiIconFissureSteelPath, Converter={StaticResource BoolToVis}}"/>
                                                    <Path Data="{StaticResource FissureSteelPathChevrons}" Fill="#F87171" Stretch="Uniform"
                                                          Visibility="{Binding HasUiIconFissureSteelPath, Converter={StaticResource InverseBoolToVis}}"/>
                                                </Grid>
                                                <TextBlock Text="Стальной путь" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource StarChartFilterButton}" Command="{Binding SetFissureCategoryCommand}" CommandParameter="Proxima"
                                                Tag="{Binding FissureCategoryFilter, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Proxima}">
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="14" Height="14" Margin="0,0,5,0">
                                                    <Image Source="{Binding UiIconFissureProxima}" Stretch="Uniform"
                                                           Visibility="{Binding HasUiIconFissureProxima, Converter={StaticResource BoolToVis}}"/>
                                                    <Path Data="{StaticResource FissureRailjackGeometry}" Fill="#67E8F9" Stretch="Uniform"
                                                          Visibility="{Binding HasUiIconFissureProxima, Converter={StaticResource InverseBoolToVis}}"/>
                                                </Grid>
                                                <TextBlock Text="Проксима" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="1" ItemsSource="{Binding DisplayFissures}" Style="{StaticResource CleanListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0B0E14" BorderBrush="#39414E" BorderThickness="1" Padding="8,5.5" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center">
                                                    <Image Source="{Binding TierBitmap}" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <Border Background="{Binding TierColor}" Width="20" Height="20"
                                                            Visibility="{Binding HasTierBitmap, Converter={StaticResource InverseBoolToVis}}">
                                                        <TextBlock Text="{Binding TierDisplay}" FontSize="6.5" FontWeight="Bold" Foreground="#090D14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TierDisplay}" FontSize="10.5" FontWeight="ExtraBold" Foreground="{Binding TierColor}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding MissionType}" FontSize="10.5" FontWeight="Bold" Foreground="#F1F5F9"/>
                                                        <Border Background="#3B1A1A" BorderBrush="#EF4444" BorderThickness="1" Padding="4,0" Margin="5,0,0,0"
                                                                Visibility="{Binding IsSteelPath, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="СП" FontSize="8" FontWeight="Bold" Foreground="#FCA5A5"/>
                                                        </Border>
                                                        <Border Background="#13253B" BorderBrush="#38BDF8" BorderThickness="1" Padding="4,0" Margin="4,0,0,0"
                                                                Visibility="{Binding IsVoidStorm, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Проксима" FontSize="8" FontWeight="Bold" Foreground="#7DD3FC"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock FontSize="9.5" Foreground="#8895A7" Margin="0,1,0,0">
                                                        <Run Text="{Binding Node, Mode=OneWay}" Foreground="#C5D0DF"/>
                                                        <Run Text="{Binding Planet, Mode=OneWay, StringFormat=' ({0})'}"/>
                                                        <Run Text="{Binding EnemyFaction, Mode=OneWay, StringFormat=' • {0}'}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TimeRemaining}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- 6. DAILY SORTIE -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveHudPanel}" Value="Sortie">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <Border Background="#0B0E14" BorderBrush="#414957" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource ClockGeometry}" Fill="#94A3B8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding DailySortie.TimeRemaining}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DailySortie.Boss}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                                            <TextBlock Text="{Binding DailySortie.Faction}" FontSize="10" Foreground="#98A4B8"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding DailySortie.Stages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0B0E14" BorderBrush="#39414E" BorderThickness="1" Padding="10,7" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='{}{0}.'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushGold}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding MissionType}" FontSize="11" FontWeight="Bold" Foreground="#F1F5F9"/>
                                                            <TextBlock Text="{Binding Node}" FontSize="10" Foreground="#98A4B8" HorizontalAlignment="Right"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Modifier}" FontSize="10" Foreground="#FBBF24" Margin="0,2,0,0" ToolTip="{Binding ModifierDesc}"/>
                                                        <TextBlock Text="{Binding ModifierDesc}" FontSize="9" Foreground="#7A869A" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 7. ARCHON HUNT (LAYERED CRYSTAL + TAUFORGED GLOW OVERLAY) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveHudPanel}" Value="Archon">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <Border Background="#0B0E14" BorderBrush="{Binding ArchonHunt.ShardColor}" BorderThickness="1" Padding="10,9" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Two-layer Archon Shard: base crystal beneath, Tauforged mythic glow centered exactly on top -->
                                        <Border Grid.Column="0" Width="46" Height="46" Background="#080B10" BorderBrush="{Binding ArchonHunt.ShardColor}" BorderThickness="1" Margin="0,0,10,0">
                                            <Grid Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding ArchonHunt.ShardBaseBitmap}" Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Image Source="{Binding ArchonHunt.ShardBitmap}" Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ArchonHunt.Boss}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <TextBlock Text="{Binding ArchonHunt.ShardTitle}" FontSize="10.5" Foreground="{StaticResource BrushGoldBright}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Path Data="{StaticResource ClockGeometry}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding ArchonHunt.TimeRemaining}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding ArchonHunt.Stages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0B0E14" BorderBrush="#39414E" BorderThickness="1" Padding="10,7" Margin="0,0,0,5">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Index, StringFormat='{}{0}.  '}" FontWeight="Bold" Foreground="{StaticResource BrushGold}" FontSize="11"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Node}" FontSize="10" Foreground="#98A4B8"/>
                                                    <TextBlock Text="{Binding MissionType}" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 8. DUVIRI SPIRAL & CIRCUIT ROTATIONS (OPENED FROM DUVIRI BUTTON) -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveHudPanel}" Value="Duviri">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="9,7" Margin="0,0,0,8" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#0E131C"/>
                                        <Setter Property="BorderBrush" Value="#2D3747"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DuviriMood.IsTrackedActive}" Value="True">
                                                <Setter Property="Background" Value="#1D162C"/>
                                                <Setter Property="BorderBrush" Value="#A855F7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DuviriMood.TimeRemaining}" FontSize="13" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock FontSize="11.5" FontWeight="Bold">
                                                <Run Text="СПИРАЛЬ ДУВИРИ: " Foreground="#8B96A8"/>
                                                <Run Text="{Binding DuviriMood.CurrentMood, Mode=OneWay}" Foreground="{StaticResource BrushCyan}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DuviriMood.MoodDescription}" FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding DuviriMoodOptions}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ToggleMoodTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="{Binding BuffShort}" Cursor="Hand" Margin="0,0,4,3">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Padding="6,2.5" BorderThickness="1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#0C111A"/>
                                                                        <Setter Property="BorderBrush" Value="#2B3648"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTracked}" Value="True">
                                                                                <Setter Property="Background" Value="#251C3A"/>
                                                                                <Setter Property="BorderBrush" Value="#A855F7"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Path Data="{StaticResource BellGeometry}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0">
                                                                        <Path.Style>
                                                                            <Style TargetType="Path">
                                                                                <Setter Property="Fill" Value="#6D7A8E"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsTracked}" Value="True">
                                                                                        <Setter Property="Fill" Value="#E9D5FF"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Path.Style>
                                                                    </Path>
                                                                    <TextBlock Text="{Binding NameRu}" FontSize="9.5" FontWeight="SemiBold" Foreground="#C5D0DF"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="РОТАЦИИ ЦЕПИ (НЕДЕЛИ 1–9)" FontSize="10.5" FontWeight="Bold" Foreground="#D8DCE5" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#080B10" BorderBrush="#2C3748" BorderThickness="1" Width="210" Height="24" Padding="6,0">
                                    <Grid>
                                        <TextBox Text="{Binding IncarnonSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource BrushTextPrimary}" CaretBrush="{StaticResource BrushCyan}" FontSize="10.5" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="Поиск Инкарнона / фрейма..." FontSize="9.5" Foreground="#5A677A" IsHitTestVisible="False" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IncarnonSearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredDuviriRotations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="9,6" Margin="0,0,0,5" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#0E131B"/>
                                                        <Setter Property="BorderBrush" Value="#252F3F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentWeek}" Value="True">
                                                                <Setter Property="Background" Value="#12231D"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource BrushSuccessGreen}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Text="{Binding DateRange}" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{StaticResource BrushGoldBright}" Margin="0,0,0,5"/>

                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 3 Warframes: uniform 46x46 tiles (38x38 icon), identical size to Incarnons -->
                                                        <ItemsControl Grid.Column="0" ItemsSource="{Binding WarframeTiles}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="46" Height="46" Background="#090D14" BorderBrush="#283549" BorderThickness="1" Margin="0,0,4,0" ToolTip="{Binding Name}">
                                                                        <Grid>
                                                                            <Image Source="{Binding IconBitmap}" Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                            <TextBlock Text="{Binding ShortLabel}" FontSize="8" Foreground="{StaticResource BrushTextMuted}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                                                       Visibility="{Binding HasLoadedIcon, Converter={StaticResource InverseBoolToVis}}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- 5 Incarnons: uniform 46x46 tiles (38x38 icon), identical size to Warframes -->
                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding IncarnonTiles}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="46" Height="46" Background="#0C131E" BorderBrush="#2A3E58" BorderThickness="1" Margin="4,0,0,0" ToolTip="{Binding Name}">
                                                                        <Grid>
                                                                            <Image Source="{Binding IconBitmap}" Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                            <TextBlock Text="{Binding Name}" FontSize="7.5" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                                                                       Visibility="{Binding HasLoadedIcon, Converter={StaticResource InverseBoolToVis}}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Bookmark button matched to exact 46px tile height -->
                                                        <Button Grid.Column="2" Command="{Binding DataContext.ToggleIncarnonBookmarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Закладка">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="BmBd" Width="30" Height="46" Background="#131924" BorderBrush="#2C3B50" BorderThickness="1">
                                                                        <TextBlock FontSize="12" Text="★" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="#63748C"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasUserBookmark}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{StaticResource BrushGoldBright}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="BmBd" Property="BorderBrush" Value="#8E9AB0"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- =============================================================== -->
        <!-- LAYER 3: NIGHTWAVE MODAL OVERLAY (WARFRAME IN-GAME STYLE)       -->
        <!-- =============================================================== -->
        <Grid Panel.ZIndex="30" Background="#E605070B" Visibility="{Binding IsNightwaveOpen, Converter={StaticResource BoolToVis}}">
            <Border Margin="14,10" Background="#F6080B12" BorderBrush="#6B528C" BorderThickness="1.2" Padding="14,11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- WARFRAME NIGHTWAVE TOP TITLE BAR -->
                    <Border Grid.Row="0" BorderBrush="#383E4F" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CloseNightwaveCommand}" Cursor="Hand" ToolTip="Закрыть окно Ночной Волны">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CloseNw" Background="#141824" BorderBrush="#596278" BorderThickness="1" Padding="10,4">
                                            <TextBlock Text="✕ ЗАКРЫТЬ" FontSize="10" FontWeight="Bold" Foreground="#E2E8F0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CloseNw" Property="Background" Value="#251B3A"/>
                                                <Setter TargetName="CloseNw" Property="BorderBrush" Value="#D8B4FE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                                        ToolTip="{Binding Nightwave.SeasonExpiryHint}">
                                <TextBlock Text="СЕЗОН: " FontSize="10" Foreground="#8B96A8" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Nightwave.SeasonTitle}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                <TextBlock Text="  •  " FontSize="10" Foreground="#4B5568" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Nightwave.TimeRemaining}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" VerticalAlignment="Center"/>
                                <TextBlock Text=" (ориент.)" FontSize="9.5" Foreground="#7A869A" VerticalAlignment="Center"
                                           Visibility="{Binding Nightwave.HasUncertainExpiry, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24" Height="24" Background="#27173D" BorderBrush="#9B66DC" BorderThickness="1" Margin="0,0,10,0">
                                    <Grid>
                                        <Image Source="{Binding Nightwave.CredIconBitmap}" Width="18" Height="18" Stretch="Uniform"
                                               Visibility="{Binding Nightwave.HasCredIcon, Converter={StaticResource BoolToVis}}"/>
                                        <Path Data="{StaticResource NightwaveMicGeometry}" Width="13" Height="13" Stretch="Uniform" Fill="#E9D5FF"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding Nightwave.HasCredIcon, Converter={StaticResource InverseBoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding NightwaveHeaderTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- =================================================== -->
                    <!-- PAGE 1: ACTS & HORIZONTAL RANK REWARDS (1-30)       -->
                    <!-- =================================================== -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NightwaveTab}" Value="Acts">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- NORA RADIO WAVEFORM BANNER -->
                        <Border Grid.Row="0" Height="44" BorderBrush="#4C366B" BorderThickness="1" Margin="0,0,0,10" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2B1646" Offset="0.0"/>
                                    <GradientStop Color="#141428" Offset="0.45"/>
                                    <GradientStop Color="#0D1626" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44" Background="#6D28D9" BorderBrush="#A855F7" BorderThickness="0,0,1,0">
                                    <Path Data="{StaticResource NightwaveMicGeometry}" Width="20" Height="20" Stretch="Uniform" Fill="#F8FAFC"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,16,0">
                                    <Grid Width="28" Height="28" Margin="0,0,12,0">
                                        <Border Width="20" Height="20" Background="#121422" BorderBrush="#C4B5FD" BorderThickness="1.2" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform>
                                        </Border>
                                        <TextBlock Text="30" FontSize="9.5" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center" MaxWidth="470">
                                        <TextBlock Text="{Binding Nightwave.SeasonTitle}" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="РАНГИ СЕЗОНА 1–30" FontSize="9" Foreground="#B4C0D4"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Decorative Nora Audio Waveform (dedicated center-right column, never collides with title) -->
                                <Path Grid.Column="2"
                                      Data="M0,22 L40,22 L54,14 L68,28 L84,18 L100,26 L118,22 L175,22 L195,12 L211,31 L227,8 L243,36 L259,16 L273,26 L295,22 L370,22 L390,15 L406,29 L422,10 L438,34 L454,18 L470,22 L560,22"
                                      StrokeThickness="1.6" Opacity="0.78" Stretch="Uniform" VerticalAlignment="Center" Margin="6,4,10,4">
                                    <Path.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#A855F7" Offset="0.0"/>
                                            <GradientStop Color="#6366F1" Offset="0.45"/>
                                            <GradientStop Color="#38BDF8" Offset="0.8"/>
                                            <GradientStop Color="#67E8F9" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Path.Stroke>
                                </Path>

                                <Grid Grid.Column="3" Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Ellipse Stroke="#67E8F9" StrokeThickness="1.5" Width="32" Height="32" Fill="#0B101B"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle Width="2" Height="10" Fill="#67E8F9" Margin="1,0"/>
                                        <Rectangle Width="2" Height="16" Fill="#E879F9" Margin="1,0"/>
                                        <Rectangle Width="2" Height="12" Fill="#38BDF8" Margin="1,0"/>
                                        <Rectangle Width="2" Height="17" Fill="#A855F7" Margin="1,0"/>
                                        <Rectangle Width="2" Height="9" Fill="#67E8F9" Margin="1,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- TOP HORIZONTAL RANK REWARDS RIBBON (LEVELS 1-30 ONLY) -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="НАГРАДЫ РАНГОВ СЕЗОНА (1–30)" FontSize="10.5" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,0,0,5"/>

                            <ScrollViewer x:Name="NightwaveRewardsScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="NightwaveRewards_PreviewMouseWheel"
                                          Padding="0,0,0,4">
                                <ItemsControl ItemsSource="{Binding Nightwave.RankRewards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="140" Height="166" Cursor="Hand">
                                                <Grid.ToolTip>
                                                    <StackPanel MaxWidth="260">
                                                        <TextBlock FontWeight="Bold" Foreground="#F8FAFC">
                                                            <Run Text="Ранг "/><Run Text="{Binding Rank, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding RewardName, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding RewardType}" FontSize="10.5" Foreground="#A7B4C7" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid.ToolTip>

                                                <!-- Horizontal connector line linking adjacent rank diamonds -->
                                                <Rectangle Height="1.2" Fill="#535F75" VerticalAlignment="Bottom" Margin="0,0,0,15"/>

                                                <!-- Reward Tile -->
                                                <Border x:Name="RewardTileBd" Margin="5,0,5,15" BorderBrush="#495367" BorderThickness="1" Padding="5,6,5,13" ClipToBounds="True">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#141925" Offset="0.0"/>
                                                            <GradientStop Color="#0B0F17" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Large crisp Reward Icon (88x88) -->
                                                        <Grid Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Image Source="{Binding IconBitmap}" Width="88" Height="88" Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Text="{Binding IconGlyph}" FontSize="32" Foreground="#526078" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasLoadedIcon, Converter={StaticResource InverseBoolToVis}}"/>
                                                        </Grid>

                                                        <!-- Quantity pill in top-right corner -->
                                                        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Background="#D9121622" BorderBrush="#9E7F3B" BorderThickness="1" Padding="5,1"
                                                                Visibility="{Binding HasCountBadge, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding CountBadge}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                                                        </Border>

                                                        <!-- Reward Name -->
                                                        <TextBlock Grid.Row="1" Text="{Binding RewardName}" FontSize="9.5" FontWeight="SemiBold"
                                                                   Foreground="#E2E8F0" TextAlignment="Center" TextWrapping="Wrap"
                                                                   MaxHeight="28" TextTrimming="CharacterEllipsis" Margin="2,3,2,0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Warframe Rotated Diamond Rank Number Badge -->
                                                <Grid Width="26" Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                    <Border x:Name="RankDiamondBd" Width="18" Height="18" Background="#0F131D" BorderBrush="#9BA8BE" BorderThickness="1.2" RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform>
                                                    </Border>
                                                    <TextBlock Text="{Binding Rank}" FontSize="9.5" FontWeight="Bold" Foreground="#F8FAFC"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RewardTileBd" Property="BorderBrush" Value="#D8B4FE"/>
                                                    <Setter TargetName="RankDiamondBd" Property="BorderBrush" Value="#E9D5FF"/>
                                                    <Setter TargetName="RankDiamondBd" Property="Background" Value="#2A1B42"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- DAILY / WEEKLY ACTS GRID -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,7">
                                <Path Data="{StaticResource NightwaveActCrestGeometry}" Width="12" Height="12" Stretch="Uniform" Fill="#C4B5FD" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center">
                                    <Run Text="ЕЖЕДНЕВНЫЕ / ЕЖЕНЕДЕЛЬНЫЕ ДЕЯНИЯ  "/>
                                    <Run Text="(ОБНОВЛЕНИЕ ЧЕРЕЗ " Foreground="#8B96A8" FontWeight="Normal"/>
                                    <Run Text="{Binding WeeklyResetRemaining, Mode=OneWay}" Foreground="{StaticResource BrushGoldBright}" FontWeight="SemiBold"/>
                                    <Run Text=")" Foreground="#8B96A8" FontWeight="Normal"/>
                                </TextBlock>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding Nightwave.Challenges}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="ActCardBd" Background="#0C1018" BorderBrush="#394254" BorderThickness="1"
                                                        Margin="0,0,6,6" MinHeight="146" ToolTip="{Binding Description}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="2"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Category color hairline -->
                                                        <Rectangle Grid.Row="0" Fill="{Binding TypeBadgeColor}" Opacity="0.85"/>

                                                        <!-- Top meta bar: Act Type & Timer -->
                                                        <DockPanel Grid.Row="1" Margin="8,6,8,0">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeRemaining}" FontSize="9" Foreground="#8E9CB3" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding TypeShortLabel}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding TypeBadgeColor}" VerticalAlignment="Center"/>
                                                        </DockPanel>

                                                        <!-- Center Crest + Title + Description -->
                                                        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="9,4,9,4">
                                                            <Path Data="{StaticResource NightwaveActCrestGeometry}" Width="30" Height="30" Stretch="Uniform"
                                                                  Fill="{Binding TypeBadgeColor}" Opacity="0.82" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                            <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="Bold" Foreground="#F1F5F9"
                                                                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="28" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="9" Foreground="#98A6BC"
                                                                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Standing Reward Footer -->
                                                        <Border Grid.Row="3" Background="#090C13" BorderBrush="#232A38" BorderThickness="0,1,0,0" Padding="6,5">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Path Data="{StaticResource NightwaveStandingGeometry}" Width="11" Height="11" Stretch="Uniform"
                                                                      Fill="#E2E8F0" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ReputationDisplay}" FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ActCardBd" Property="BorderBrush" Value="#B4C0D4"/>
                                                        <Setter TargetName="ActCardBd" Property="Background" Value="#121826"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Деяния Ночной Волны загрузятся после синхронизации с Worldstate API..."
                                               FontSize="11" Foreground="#7A869A" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Nightwave.Challenges.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- =================================================== -->
                    <!-- PAGE 2: CRED OFFERINGS (SQUARE CARDS GRID)          -->
                    <!-- =================================================== -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NightwaveTab}" Value="Shop">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Category Filters & Search Bar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <Border DockPanel.Dock="Right" Background="#080B10" BorderBrush="#394357" BorderThickness="1" Width="250" Height="27" Padding="8,0" Margin="10,0,0,0">
                                <Grid>
                                    <TextBox Text="{Binding NightwaveShopSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource BrushTextPrimary}" CaretBrush="{StaticResource BrushCyan}" FontSize="10.5" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="ПОИСК..." FontSize="9.5" Foreground="#606E82" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NightwaveShopSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="ВСЕ" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterNightwaveOfferingsCommand}" CommandParameter="All"
                                        Tag="{Binding NightwaveOfferingFilter, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=All}"/>
                                <Button Content="Ауры и Моды" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterNightwaveOfferingsCommand}" CommandParameter="Aura"
                                        Tag="{Binding NightwaveOfferingFilter, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Aura}"/>
                                <Button Content="Оружие" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterNightwaveOfferingsCommand}" CommandParameter="Weapon"
                                        Tag="{Binding NightwaveOfferingFilter, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Weapon}"/>
                                <Button Content="Ресурсы и Кува" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterNightwaveOfferingsCommand}" CommandParameter="Resource"
                                        Tag="{Binding NightwaveOfferingFilter, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Resource}"/>
                                <Button Content="Косметика" Style="{StaticResource StarChartFilterButton}" Command="{Binding FilterNightwaveOfferingsCommand}" CommandParameter="Cosmetic"
                                        Tag="{Binding NightwaveOfferingFilter, Converter={x:Static ctrl:StringEqualsTagConverter.Instance}, ConverterParameter=Cosmetic}"/>
                            </WrapPanel>
                        </DockPanel>

                        <!-- Virtualized Square Tile Offerings Grid -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Nightwave.DisplayOfferings}"
                                 Style="{StaticResource CleanListBoxStyle}"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctrl:VirtualizingWrapPanel ItemWidth="154" ItemHeight="154"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ShopSquareTile" Width="144" Height="144" Margin="5" BorderBrush="#3E4759" BorderThickness="1" ClipToBounds="True" Cursor="Hand">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#141925" Offset="0.0"/>
                                                <GradientStop Color="#0A0E16" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.ToolTip>
                                            <StackPanel MaxWidth="280">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <TextBlock FontSize="10.5" Foreground="{StaticResource BrushGoldBright}" Margin="0,2,0,0">
                                                    <Run Text="{Binding CredCost, Mode=OneWay}"/><Run Text=" Доверия • "/><Run Text="{Binding Category, Mode=OneWay}" Foreground="#A7B4C7"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border.ToolTip>
                                        <Grid>
                                            <!-- Large Centered Square Item Artwork -->
                                            <Image Source="{Binding IconBitmap}" Width="88" Height="88" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,24"/>
                                            <TextBlock Text="{Binding IconGlyph}" FontSize="30" Foreground="#526078" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,16"
                                                       Visibility="{Binding HasLoadedIcon, Converter={StaticResource InverseBoolToVis}}"/>

                                            <!-- Top-Left Cred Cost Pill -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0"
                                                    Background="#D90B0F17" BorderBrush="#8F7334" BorderThickness="1" Padding="5,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding DataContext.Nightwave.CredIconBitmap, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"
                                                           Visibility="{Binding DataContext.Nightwave.HasCredIcon, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding CredCost}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bottom Name Bar -->
                                            <Border VerticalAlignment="Bottom" Padding="5,4" MinHeight="32">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#B8070A10" Offset="0.0"/>
                                                        <GradientStop Color="#F2070A10" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#E5ECF5"
                                                           TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                                           MaxHeight="28" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ShopSquareTile" Property="BorderBrush" Value="#E2E8F0"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- WARFRAME NIGHTWAVE BOTTOM ACTION BAR -->
                    <Border Grid.Row="2" BorderBrush="#2D3445" BorderThickness="0,1,0,0" Padding="0,9,0,0" Margin="0,8,0,0">
                        <DockPanel>
                            <!-- Right Action Buttons -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <!-- Shown on Acts Page -> Go to Cred Offerings -->
                                <Button Command="{Binding SwitchNightwaveTabCommand}" CommandParameter="Shop" Cursor="Hand" Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NightwaveTab}" Value="Acts">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnShop" Background="#1D152E" BorderBrush="#9B66DC" BorderThickness="1" Padding="14,6">
                                                <TextBlock Text="ПРЕДЛОЖЕНИЯ ЗА ДОВЕРИЕ" FontSize="10.5" FontWeight="Bold" Foreground="#F3E8FF"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnShop" Property="Background" Value="#2D1F4B"/>
                                                    <Setter TargetName="BtnShop" Property="BorderBrush" Value="#E9D5FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Shown on Shop Page -> Back to Acts & Rewards -->
                                <Button Command="{Binding SwitchNightwaveTabCommand}" CommandParameter="Acts" Cursor="Hand" Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NightwaveTab}" Value="Shop">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnActs" Background="#1D152E" BorderBrush="#9B66DC" BorderThickness="1" Padding="14,6">
                                                <TextBlock Text="← ДЕЯНИЯ И НАГРАДЫ" FontSize="10.5" FontWeight="Bold" Foreground="#F3E8FF"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnActs" Property="Background" Value="#2D1F4B"/>
                                                    <Setter TargetName="BtnActs" Property="BorderBrush" Value="#E9D5FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Close Button ("ВЫХОД") -->
                                <Button Command="{Binding CloseNightwaveCommand}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnExit" Background="#121621" BorderBrush="#525C70" BorderThickness="1" Padding="16,6">
                                                <TextBlock Text="ВЫХОД" FontSize="10.5" FontWeight="Bold" Foreground="#DCE3EE"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnExit" Property="Background" Value="#1E2636"/>
                                                    <Setter TargetName="BtnExit" Property="BorderBrush" Value="#E2E8F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Left Weekly Offerings Reset Timer -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource ClockGeometry}" Width="18" Height="18" Stretch="Uniform" Fill="#CBD5E1" Margin="0,0,8,0"/>
                                <TextBlock FontSize="10.5" Foreground="#B4C0D4" VerticalAlignment="Center">
                                    <Run Text="ОБНОВЛЕНИЕ ТОВАРОВ ЧЕРЕЗ "/>
                                    <Run Text="{Binding WeeklyResetRemaining, Mode=OneWay}" Foreground="#F8FAFC" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#6D7A8F" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NightwaveTab}" Value="Shop">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="•  Показано: "/><Run Text="{Binding Nightwave.DisplayOfferings.Count, Mode=OneWay}" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

