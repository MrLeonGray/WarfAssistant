<UserControl x:Class="WarfAssistant.Views.MarketRivenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1150">
    <UserControl.Resources>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource BrushBgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderBright}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="8,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="▾" Foreground="{StaticResource BrushGold}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{StaticResource BrushTextPrimary}"
                                              Margin="9,5,24,5" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#111824" BorderBrush="{StaticResource BrushGold}" BorderThickness="1"
                                        CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="270" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#1E2C40"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushCyan}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER + SUB-TAB SWITCHER -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WARFRAME.MARKET &amp; ПОМОЩНИК ПО МОДАМ РАЗЛОМА" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushGold}" VerticalAlignment="Center"/>
                    <Border Background="#182534" CornerRadius="4" Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LIVE API • CROSSPLAY PC" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton Content="🛒 Warframe.Market" GroupName="MarketRivenSub" IsChecked="{Binding IsMarketTab, Mode=OneWay}"
                                 Command="{Binding SwitchSubTabCommand}" CommandParameter="Market"
                                 Style="{StaticResource TargetPresetButton}" Margin="0,0,6,0"/>
                    <RadioButton Content="🎲 Моды Разлома (Rivens)" GroupName="MarketRivenSub" IsChecked="{Binding IsRivenTab, Mode=OneWay}"
                                 Command="{Binding SwitchSubTabCommand}" CommandParameter="Riven"
                                 Style="{StaticResource TargetPresetButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================== -->
        <!-- SUB-VIEW 1: WARFRAME MARKET (ITEMS, ARBITRAGE, WATCHLIST)  -->
        <!-- ========================================================== -->
        <Grid Grid.Row="1" Visibility="{Binding IsMarketTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Search + Item Catalog + Saved Watchlist -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.35*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="0.85*"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <Border Grid.Row="0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,8">
                    <Grid>
                        <TextBox Text="{Binding MarketSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextPrimary}" FontSize="12"/>
                        <TextBlock Text="🔍 Поиск предмета, сета, мистика, мода..." Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="11" IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MarketSearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Catalog Search Results -->
                <Border Grid.Row="1" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MarketSearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectMarketItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Background="#141C28" BorderBrush="#233247" BorderThickness="1"
                                            Padding="7,5" Margin="0,0,0,4" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="{Binding IconBitmap}" Width="26" Height="26" Stretch="Uniform"/>
                                                        <StackPanel Grid.Column="1" Margin="7,0,4,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding NameRu}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding NameEn}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding DucatTag}" FontSize="9.5" FontWeight="Bold"
                                                                   Foreground="{StaticResource BrushGold}" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasDucats, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushCyan}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Watchlist -->
                <Border Grid.Row="3" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="★ ИЗБРАННОЕ (ОТСЛЕЖИВАЕМЫЕ)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGold}" Margin="0,0,0,6"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Watchlist}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBgSurface}" CornerRadius="4" Padding="7,4" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding DataContext.OpenWatchlistItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                                    <TextBlock Text="{Binding NameRu}" FontSize="10.5" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LastMinSell, StringFormat='{}{0} Пл'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" Margin="0,0,6,0"/>
                                                    <Button Content="✕" Command="{Binding DataContext.RemoveWatchlistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushHealthRed}" FontSize="9" Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT: Item Price Analytics, Arbitrage & Live In-Game Orders -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Selected Item Summary Card (Enlarged Game-HUD Profile w/ Large Thumbnail) -->
                <Border Grid.Row="0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderBright}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="72" Height="72" CornerRadius="7" Background="#0C111A" BorderBrush="#2E425D" BorderThickness="1">
                            <Image Source="{Binding SelectedMarketItem.IconBitmap}" Stretch="Uniform" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedMarketItem.DisplayName}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource BrushGold}" TextWrapping="Wrap"/>
                                <TextBlock Text="⏳ Загрузка..." FontSize="10.5" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="{Binding IsLoadingMarket, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource BrushCyan}" Margin="0,5,0,0" TextWrapping="Wrap">
                                <Run Text="48ч: "/>
                                <Run Text="{Binding CurrentAnalysis.Avg48hPrice, Mode=OneWay, StringFormat='{}{0:F1} Пл'}" FontWeight="Bold"/>
                                <Run Text=" ("/>
                                <Run Text="{Binding CurrentAnalysis.Volume48h, Mode=OneWay}"/>
                                <Run Text=" шт) • 90д: "/>
                                <Run Text="{Binding CurrentAnalysis.Avg90dPrice, Mode=OneWay, StringFormat='{}{0:F1} Пл'}" FontWeight="Bold"/>
                                <Run Text=" ("/>
                                <Run Text="{Binding CurrentAnalysis.Volume90d, Mode=OneWay}"/>
                                <Run Text=" шт) • Дукат/Пл: "/>
                                <Run Text="{Binding CurrentAnalysis.PlatPerDucat, Mode=OneWay, StringFormat='{}{0:F1}'}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🪙 Дукат-арбитраж" Command="{Binding ScanDucatArbitrageCommand}" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                                    ToolTip="Найти лучшие Прайм-части по соотношению Дукатов к цене в Платине"/>
                            <Button Content="★ В избранное" Command="{Binding AddWatchlistCommand}" Style="{StaticResource PillButton}" Margin="0,0,6,0"/>
                            <Button Content="🔄 Обновить" Command="{Binding SelectMarketItemCommand}" CommandParameter="{Binding SelectedMarketItem}" Style="{StaticResource GoldButton}" Padding="11,6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPIs + Set Arbitrage Banner + Set Parts Breakdown + Ducat Arbitrage Scanner -->
                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="10,8" BorderBrush="#1F3A2C" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="МИН. ПРОДАЖА (SELL)" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBlock Text="{Binding CurrentAnalysis.MinSellPrice, StringFormat='{}{0} Пл'}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource BrushSuccessGreen}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="10,8" BorderBrush="#233247" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="МЕДИАНА ТОП-12" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBlock Text="{Binding CurrentAnalysis.MedianSellPrice, StringFormat='{}{0} Пл'}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="10,8" BorderBrush="#233247" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="МАКС. СКУПКА (BUY)" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBlock Text="{Binding CurrentAnalysis.MaxBuyPrice, StringFormat='{}{0} Пл'}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Background="#141F2C" CornerRadius="6" Padding="10,8" BorderBrush="{StaticResource BrushCyan}" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="АРБИТРАЖ (СЕТ vs ЧАСТИ)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                            <TextBlock Text="{Binding CurrentAnalysis.ArbitrageSummary, TargetNullValue='Выберите *_set для расчёта выгоды покупки по частям'}"
                                       FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Set Parts Breakdown Pills -->
                <ItemsControl ItemsSource="{Binding SetParts}" Margin="0,6,0,0"
                              Visibility="{Binding HasSetParts, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#111926" BorderBrush="#24354B" BorderThickness="1" CornerRadius="4" Padding="6,2.5" Margin="0,0,5,3">
                                <TextBlock FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}">
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                    <Run Text=": "/>
                                    <Run Text="{Binding MinSellPrice, Mode=OneWay, StringFormat='{}{0} Пл'}" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Ducat Arbitrage Scanner Results -->
                <Border Background="#171E2A" BorderBrush="#854D0E" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,6,0,0"
                        Visibility="{Binding HasDucatArbitrage, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="🪙 ТОП ПРЕДМЕТОВ НА ДУКАТЫ (ДУКАТ / ПЛАТИНА)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushGold}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding DucatArbitrageItems}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F1622" BorderBrush="#35465C" BorderThickness="1" CornerRadius="4" Padding="6,2.5" Margin="0,0,5,3">
                                        <TextBlock FontSize="9.5" Foreground="{StaticResource BrushTextPrimary}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding RatioDisplay, Mode=OneWay}" Foreground="{StaticResource BrushGoldBright}" FontWeight="Bold"/>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Two Columns: Live Sell Orders & Buy Orders -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SELL ORDERS -->
                    <Border Grid.Column="0" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ПРОДАВЦЫ ОНЛАЙН (IN GAME)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushSuccessGreen}" Margin="0,0,0,7"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SellOrders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="#1F2C3D" BorderThickness="1" CornerRadius="5" Padding="9,6" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="● " FontSize="9" Foreground="{StaticResource BrushSuccessGreen}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding UserIngameName}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                            <TextBlock Text="{Binding RankLabel}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock FontSize="9" Foreground="{StaticResource BrushTextMuted}">
                                                            <Run Text="Кол-во: "/>
                                                            <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                                            <Run Text=" • Реп: "/>
                                                            <Run Text="{Binding Reputation, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Platinum, StringFormat='{}{0} Пл'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <Button Content="📋 Купить" Command="{Binding DataContext.CopyWhisperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource PillButton}" FontSize="10" Padding="7,3"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- BUY ORDERS -->
                    <Border Grid.Column="2" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ПОКУПАТЕЛИ ОНЛАЙН (СКУПКА)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,7"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding BuyOrders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="#1F2C3D" BorderThickness="1" CornerRadius="5" Padding="9,6" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding UserIngameName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                        <TextBlock Text="{Binding Quantity, StringFormat='Готов купить: {0} шт.'}" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Platinum, StringFormat='{}{0} Пл'}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <Button Content="📋 Продать" Command="{Binding DataContext.CopyWhisperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource PillButton}" FontSize="10" Padding="7,3"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ========================================================== -->
        <!-- SUB-VIEW 2: RIVEN MOD HELPER (GRADER + AUCTIONS + BUILDER) -->
        <!-- ========================================================== -->
        <Grid Grid.Row="1" Visibility="{Binding IsRivenTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="385"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="355"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- COL 1: RIVEN ROLL CONFIGURATOR -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="КОНСТРУКТОР И ДИАПАЗОНЫ МОДА РАЗЛОМА" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGold}" Margin="0,0,0,6"/>

                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="9" Margin="0,0,0,8" BorderBrush="{StaticResource BrushBorderBright}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="6" Background="#0C111A" BorderBrush="#2D425C" BorderThickness="1" VerticalAlignment="Center">
                                    <Image Source="{Binding SelectedRivenWeapon.IconBitmap}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBox Text="{Binding RivenWeaponSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                                             Foreground="{StaticResource BrushTextPrimary}" FontSize="11" Padding="6,4" Margin="0,0,0,5"
                                             ToolTip="Поиск оружия для мода Разлома"/>
                                    <ComboBox ItemsSource="{Binding FilteredRivenWeapons}" SelectedItem="{Binding SelectedRivenWeapon}"
                                              DisplayMemberPath="DisplayName" Style="{StaticResource DarkCombo}"/>
                                    <ComboBox ItemsSource="{Binding RivenVariants}" SelectedItem="{Binding SelectedRivenVariant}"
                                              DisplayMemberPath="DisplayName" Style="{StaticResource DarkCombo}" Margin="0,4,0,0"
                                              ToolTip="Выберите вариант оружия (Prime / Kuva / Vandal и т.д.) для точной синергии"/>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock Text="Синергия Разлома:" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock Text="{Binding ActiveRivenDispositionText}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushCyan}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Config + Rerolls -->
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="9" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding RivenConfigs}" SelectedItem="{Binding SelectedRivenConfig}" Style="{StaticResource DarkCombo}" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Роллов:" FontSize="10" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Text="{Binding RivenRerolls, UpdateSourceTrigger=PropertyChanged}" Width="46" FontSize="11" FontWeight="Bold"
                                             Foreground="{StaticResource BrushGold}" Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}"
                                             BorderThickness="1" TextAlignment="Center" Padding="3,3"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Positive Stat Slots -->
                        <ItemsControl ItemsSource="{Binding PositiveSlots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="#233247" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6"
                                            Visibility="{Binding IsSlotActive, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="{Binding SlotLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushSuccessGreen}"/>
                                                <TextBlock Text="{Binding RangeText}" HorizontalAlignment="Right" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" ItemsSource="{Binding DataContext.CompatiblePositiveAttrs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding SelectedAttr}" DisplayMemberPath="EffectRu" Style="{StaticResource DarkCombo}"/>
                                                <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" FontSize="12" FontWeight="Bold"
                                                         Foreground="{StaticResource BrushGoldBright}" Background="{StaticResource BrushBgInput}"
                                                         BorderBrush="{StaticResource BrushBorderBright}" BorderThickness="1" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding QualityPercent, Mode=OneWay}" Maximum="100" Height="3" Margin="0,5,0,0"
                                                         Background="#0E141E" Foreground="{Binding QualityColor}" BorderThickness="0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Negative Curse Slot -->
                        <Border Background="#1B1318" BorderBrush="#4C2230" BorderThickness="1" CornerRadius="6" Padding="8"
                                Visibility="{Binding HasNegativeCurse, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding NegativeSlot.SlotLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushHealthRed}"/>
                                    <TextBlock Text="{Binding NegativeSlot.RangeText}" HorizontalAlignment="Right" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding CompatibleNegativeAttrs}"
                                              SelectedItem="{Binding NegativeSlot.SelectedAttr}" DisplayMemberPath="EffectRu" Style="{StaticResource DarkCombo}"/>
                                    <TextBox Grid.Column="2" Text="{Binding NegativeSlot.Value, UpdateSourceTrigger=LostFocus}" FontSize="12" FontWeight="Bold"
                                             Foreground="{StaticResource BrushHealthRed}" Background="{StaticResource BrushBgInput}"
                                             BorderBrush="#5C2836" BorderThickness="1" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- COL 2: GRADER VERDICT, BUILDER BRIDGE, WEEKLY DE STATS & SAVED LOCKER -->
            <Border Grid.Column="2" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Grade Banner -->
                        <Border Background="{StaticResource BrushBgCard}" BorderBrush="{Binding Evaluation.GradeColor}" BorderThickness="1.5"
                                CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="8" Background="#0D141F" BorderBrush="{Binding Evaluation.GradeColor}" BorderThickness="1.5">
                                    <TextBlock Text="{Binding Evaluation.Grade}" FontSize="24" FontWeight="ExtraBold" Foreground="{Binding Evaluation.GradeColor}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Evaluation.Verdict}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Evaluation.KuvaSummary}" FontSize="9.5" Foreground="{StaticResource BrushGold}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Curse Verdict -->
                        <Border Background="#111822" BorderBrush="{Binding Evaluation.CurseColor}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Evaluation.CurseVerdict}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Evaluation.CurseColor}" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Action Bridges -->
                        <UniformGrid Columns="1" Margin="0,0,0,8">
                            <Button Content="⚡ Проверить этот Riven в Связанном Билдере" Command="{Binding TestRivenInBuilderCommand}"
                                    Style="{StaticResource GoldButton}" Padding="10,7" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🔍 Найти аналоги WFM" Command="{Binding FetchAuctionsCommand}" Style="{StaticResource WarfButton}" Padding="8,6" FontSize="10.5"/>
                                <Button Grid.Column="2" Content="💾 Сохранить мод" Command="{Binding SaveRivenCommand}" Style="{StaticResource WarfButton}" Padding="8,6" FontSize="10.5"/>
                            </Grid>
                        </UniformGrid>

                        <!-- DE Official Weekly Riven Stats -->
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="6" Padding="9" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="📊 НЕДЕЛЬНАЯ СТАТИСТИКА ТОРГОВ DE (PC)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding WeeklyUnrolledText}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding WeeklyRolledText}" FontSize="10" Foreground="{StaticResource BrushGold}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Saved Rivens Locker -->
                        <TextBlock Text="🗄 СОХРАНЁННЫЕ МОДЫ РАЗЛОМА" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGold}" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding SavedRivens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="#233247" BorderThickness="1" CornerRadius="5" Padding="7,5" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#1D2A3A" CornerRadius="4" Padding="6,2" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Grade}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding WeaponName}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding StatsSummary}" FontSize="9" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="✕" Command="{Binding DataContext.DeleteSavedRivenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushHealthRed}" Cursor="Hand" FontSize="10"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- COL 3: LIVE AUCTIONS & VEILED CHALLENGES -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.25*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="0.95*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏛 ЖИВЫЕ АУКЦИОНЫ WARFRAME.MARKET" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushGold}"/>
                                <TextBlock Text="⏳ Поиск..." FontSize="9.5" Foreground="{StaticResource BrushCyan}" Margin="8,0,0,0"
                                           Visibility="{Binding IsLoadingAuctions, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedRivenWeapon.NameEn}" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource BrushCyan}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Нажмите [🔍 Найти аналоги WFM], чтобы загрузить реальные лоты игроков с точными статами и ценами."
                                           FontSize="10" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LiveAuctions.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding LiveAuctions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BrushBgCard}" BorderBrush="#233247" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <WrapPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding PriceBadge}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}" Margin="0,0,8,0"/>
                                                            <TextBlock FontSize="9.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                <Run Text="Роллов: "/>
                                                                <Run Text="{Binding Rerolls, Mode=OneWay}"/>
                                                                <Run Text=" • "/>
                                                                <Run Text="{Binding OwnerName, Mode=OneWay}"/>
                                                                <Run Text=" ("/>
                                                                <Run Text="{Binding OwnerStatus, Mode=OneWay}"/>
                                                                <Run Text=")"/>
                                                            </TextBlock>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding AttributesText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="📋 ЛС" Command="{Binding DataContext.CopyWhisperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource PillButton}" FontSize="9.5" Padding="7,3" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Veiled Riven Challenges Quick Cheatsheet -->
                <Border Grid.Row="2" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="🗝️ ШПАРГАЛКА ПО ОТКРЫТИЮ ЗАКРЫТЫХ МОДОВ РАЗЛОМА" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGold}" Margin="0,0,0,6"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding VeiledChallenges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBgSurface}" CornerRadius="5" Padding="8,5" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock FontSize="9.5" Foreground="{StaticResource BrushCyan}">
                                                    <Run Text="{Binding OptimalFrame, Mode=OneWay}"/>
                                                    <Run Text=" • "/>
                                                    <Run Text="{Binding OptimalNode, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Tip}" FontSize="9" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
