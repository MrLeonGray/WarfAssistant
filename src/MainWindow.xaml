<Window x:Class="WarfAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WarfAssistant.ViewModels"
        xmlns:views="clr-namespace:WarfAssistant.Views"
        xmlns:ctrl="clr-namespace:WarfAssistant.Controls"
        mc:Ignorable="d"
        Title="WarfAssistant" Height="860" Width="1380"
        MinHeight="740" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}"
        Foreground="{StaticResource BrushTextPrimary}"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="{StaticResource BrushBgDeep}">
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="40"/>
            <!-- Main Content + Sidebar -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!-- CUSTOM TITLE BAR                               -->
        <!-- ============================================== -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgSurface}" 
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="22" Height="22" Background="#231C0D" BorderBrush="{StaticResource BrushGold}" 
                            BorderThickness="1.5" CornerRadius="4" Margin="0,0,10,0">
                        <TextBlock Text="⚔" FontSize="11" Foreground="{StaticResource BrushGold}" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center">
                        <Run Text="WARF" Foreground="{StaticResource BrushGold}"/>
                        <Run Text="ASSISTANT" Foreground="{StaticResource BrushTextPrimary}"/>
                    </TextBlock>
                    <Border Background="#1B160C" BorderBrush="{StaticResource BrushBorderGold}" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ORBITER HUD • LIVE DE API" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushGoldBright}"/>
                    </Border>
                </StackPanel>

                <!-- Center Drag Area / Info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🛡 БЕЗОПАСНЫЙ РЕЖИМ (БЕЗ ЧТЕНИЯ ПАМЯТИ И ИНЖЕКТА)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccessGreen}"/>
                </StackPanel>

                <!-- Window Control Buttons (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="42" Height="40" Background="Transparent" BorderThickness="0" 
                            Click="MinimizeButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                                    <Path Data="M0,0 L10,0" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.5" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#1C2636"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Width="42" Height="40" Background="Transparent" BorderThickness="0" 
                            Click="MaximizeButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                                    <Rectangle Width="10" Height="10" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.5"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#1C2636"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Width="44" Height="40" Background="Transparent" BorderThickness="0" 
                            Click="CloseButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.5" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#DC2626"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- MAIN WORKSPACE: SIDEBAR + VIEW CONTENT         -->
        <!-- ============================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Compact Sidebar Navigation Rail -->
                <ColumnDefinition Width="220"/>
                <!-- View Container -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR (NEW ORDER: ЭВЕНТЫ / КРАФТ / БИЛДЫ / КОЛЛЕКЦИИ / НАСТРОЙКИ) -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgSurface}" 
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Navigation Category Label -->
                    <TextBlock Grid.Row="0" Text="МОДУЛИ АССИСТЕНТА" FontSize="10" FontWeight="Bold" 
                               Foreground="{StaticResource BrushTextMuted}" Margin="16,14,0,8"/>

                    <!-- Navigation Menu Items in the requested order -->
                    <StackPanel Grid.Row="1" Margin="6,0">
                        <!-- 1. Events Tab (FIRST) -->
                        <RadioButton Style="{StaticResource NavTabItemStyle}" 
                                     GroupName="NavTabs"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Events}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Events">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱" FontSize="14" Margin="0,0,10,0" Foreground="{StaticResource BrushGold}"/>
                                <TextBlock Text="Эвенты &amp; Мир" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 2. Crafting Tab -->
                        <RadioButton Style="{StaticResource NavTabItemStyle}" 
                                     GroupName="NavTabs"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Crafting}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Crafting">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔨" FontSize="14" Margin="0,0,10,0" Foreground="{StaticResource BrushCyan}"/>
                                <TextBlock Text="Крафт &amp; Фарм" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 3. Builder Tab -->
                        <RadioButton Style="{StaticResource NavTabItemStyle}" 
                                     GroupName="NavTabs"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Builder}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Builder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,10,0" Foreground="{StaticResource BrushGold}"/>
                                <TextBlock Text="Связанный Билдер" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 4. Collection Tab -->
                        <RadioButton Style="{StaticResource NavTabItemStyle}" 
                                     GroupName="NavTabs"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Collection}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Collection">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="14" Margin="0,0,10,0" Foreground="{StaticResource BrushCyan}"/>
                                <TextBlock Text="Коллекция" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 5. Market & Rivens Tab (Stage 6) -->
                        <RadioButton Style="{StaticResource NavTabItemStyle}" 
                                     GroupName="NavTabs"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=MarketRiven}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="MarketRiven">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚖" FontSize="14" Margin="0,0,10,0" Foreground="{StaticResource BrushGold}"/>
                                <TextBlock Text="Маркет и Моды разлома" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 6. Settings Tab -->
                        <RadioButton Style="{StaticResource NavTabItemStyle}" 
                                     GroupName="NavTabs"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={x:Static ctrl:StringEqualsConverter.Instance}, ConverterParameter=Settings}"
                                     Command="{Binding SwitchTabCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="14" Margin="0,0,10,0" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="Настройки &amp; Кэш" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom Quick Profile Card + Live MR Progress Bar -->
                    <Border Grid.Row="2" Background="{StaticResource BrushBgCard}" 
                            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" 
                            Padding="12,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding PlayerName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="135"/>
                                <TextBlock Text="{Binding MasterySummary.CurrentRankNumber, StringFormat='MR {0}'}" HorizontalAlignment="Right" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource BrushGoldBright}"/>
                            </Grid>
                            <ProgressBar Value="{Binding MasterySummary.ProgressPercent, Mode=OneWay}" Maximum="100" Height="4"
                                         Background="#0B0F17" Foreground="{StaticResource BrushGold}" BorderThickness="0" Margin="0,0,0,8"/>

                            <Button Content="📁 Папка сохранений" 
                                    Style="{StaticResource WarfButton}" 
                                    Command="{Binding OpenSaveFolderCommand}"
                                    Padding="10,6" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT VIEW CONTENT HOST -->
            <Grid Grid.Column="1">
                <!-- 1. Events View (Default) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Events">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <views:EventsView x:Name="ViewEvents" DataContext="{Binding Events}"/>
                </Grid>

                <!-- 2. Crafting View -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Crafting">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <views:CraftingView x:Name="ViewCrafting" DataContext="{Binding Crafting}"/>
                </Grid>

                <!-- 3. Builder View -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Builder">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <views:BuilderView x:Name="ViewBuilder" DataContext="{Binding Builder}"/>
                </Grid>

                <!-- 4. Collection View -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Collection">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <views:CollectionView x:Name="ViewCollection" DataContext="{Binding Collection}"/>
                </Grid>

                <!-- 5. Market & Rivens View -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="MarketRiven">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <views:MarketRivenView x:Name="ViewMarketRiven" DataContext="{Binding MarketRiven}"/>
                </Grid>

                <!-- 6. Settings View -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <views:SettingsView x:Name="ViewSettings"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================== -->
        <!-- STATUS BAR                                     -->
        <!-- ============================================== -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" 
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" 
                Padding="14,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="● " FontSize="10" Foreground="{StaticResource BrushSuccessGreen}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="{Binding Collection.SyncStatusText}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding Events.SyncLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushGold}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
